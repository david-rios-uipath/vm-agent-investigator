            {
              "id": "continue",
              "label": "continue",
              "type": "target",
              "handleType": "input"
            },
            {
              "id": "break",
              "label": "break",
              "type": "target",
              "handleType": "input",
              "visible": "inputs.breakEnabled"
            }
          ]
        }
      ],
      "model": {
        "type": "bpmn:SubProcess"
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "collection": {
            "type": "array"
          },
          "parallel": {
            "type": "boolean"
          },
          "completionCondition": {
            "type": "string"
          },
          "breakEnabled": {
            "type": "boolean"
          }
        },
        "required": [
          "collection"
        ]
      },
      "inputDefaults": {
        "collection": [],
        "parallel": false,
        "completionCondition": "",
        "breakEnabled": false
      },
      "outputDefinition": {
        "currentItem": {
          "type": "any",
          "description": "The current item being iterated in the loop",
          "source": "=loopContext.currentItem",
          "var": "currentItem",
          "scope": "internal"
        },
        "currentIteration": {
          "type": "number",
          "description": "The current iteration number (1-based)",
          "source": "=loopContext.currentIteration",
          "var": "currentIteration",
          "scope": "internal"
        },
        "collection": {
          "type": "array",
