{
  "id": "5567126c-2bce-4e36-9246-ce0a46278c73",
  "version": "1.9",
  "name": "NightlyOrchestrator",
  "runtime": "maestro",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger",
        "icon": "play"
      },
      "inputs": {
        "entryPointId": "e9d564fb-68e7-4326-8f6f-b9d9a8c5d326",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the process.",
          "source": "null",
          "var": "output",
          "schema": {
            "type": "object",
            "properties": {
              "runId": {
                "type": "string"
              },
              "sha": {
                "type": "string"
              },
              "runUrl": {
                "type": "string"
              },
              "reportUrl": {
                "type": "string"
              },
              "slackTs": {
                "type": "string"
              },
              "projects": {
                "type": "string"
              },
              "repoUrl": {
                "type": "string"
              },
              "branch": {
                "type": "string"
              },
              "claudeModel": {
                "type": "string"
              },
              "resumeRunId": {
                "type": "string"
              },
              "maxTests": {
                "type": "number"
              },
              "maxFixAttempts": {
                "type": "number"
              },
              "failedTests": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "project": {
                      "type": "string"
                    },
                    "file": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "id": "selectTests",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Select tests",
        "subLabel": "dedupe, group by cause",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "fieldType": "string",
          "expression": "const s = $vars.start.output;\nconst globs = String(s.projects || 'studio-*,vsix-*').split(',').map(g => g.trim()).filter(Boolean);\nconst matches = (p) => globs.some(g => new RegExp('^' + g.split('*').map(x => x.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&')).join('.*') + '$').test(p));\n// One row per distinct test (same file+title across shards/platforms collapses).\nconst seen = new Set();\nconst rows = [];\nfor (const t of (s.failedTests || [])) {\n  if (!t || !matches(t.project || '')) continue;\n  const key = t.file + '::' + t.title;\n  if (seen.has(key)) continue;\n  seen.add(key);\n  rows.push(t);\n}\nrows.sort((a, b) => (a.file + a.title).localeCompare(b.file + b.title));\n// Tests whose first error line matches (digits/hashes ignored) share a cause. A named `Error:` groups\n// across spec files (shared infra failure); a bare timeout/locator message only within its file.\nconst norm = (e) => String(e || '').replace(/\\x1b\\[[0-9;]*m/g, '').split('\\n').map(l => l.trim()).find(Boolean) || '';\nconst causeKey = (t) => {\n  const n = norm(t.error).replace(/[0-9a-f]{8,}/gi, '#').replace(/\\d+/g, '#').slice(0, 160);\n  if (!n) return t.file + '::title:' + t.title;\n  return /^\\w*Error: /.test(n) && !/^TimeoutError/.test(n) ? 'err::' + n : t.file + '::' + n;\n};\nconst groups = [];\nconst byKey = new Map();\nfor (const t of rows) {\n  const k = causeKey(t);\n  const g = byKey.get(k);\n  if (g) { g.siblings.push(g.file === t.file ? t.title : `${t.file.split('/').pop()} › ${t.title}`); continue; }\n  const ng = { ...t, siblings: [] }; byKey.set(k, ng); groups.push(ng);\n}\n// Biggest cause first: it explains the most red.\ngroups.sort((a, b) => b.siblings.length - a.siblings.length);\nconst grep = (title) => String(title).replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&').replace(/\"/g, '\\\\\"');\nconst groups2 = groups.map(t => ({\n  project: t.project, file: t.file, title: t.title, error: t.error || '', siblings: t.siblings,\n  testCommand: `corepack pnpm exec playwright test --config e2e/playwright.config.ts e2e/${t.file} --project ${t.project} --grep \"${grep(t.title)}\"`\n}));\nreturn { groups: groups2, total: groups2.length, totalTests: rows.length };"
        }
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
          "schema": {
            "type": "object",
            "properties": {
              "total": {
                "type": "number"
              },
              "totalTests": {
                "type": "number"
              },
              "groups": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "project": {
                      "type": "string"
                    },
                    "file": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "testCommand": {
                      "type": "string"
                    },
                    "siblings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "investigate",
      "type": "core.logic.loop",
      "typeVersion": "2.4",
      "display": {
        "label": "Investigate each test",
        "subLabel": "parallel, one VmAgent per test",
        "icon": "repeat"
      },
      "inputs": {
        "collection": "=js:$vars.pickTests.output['selected']",
        "parallel": true
      },
      "outputs": {
        "currentItem": {
          "type": "any",
          "description": "The current item being iterated in the loop",
          "scope": "internal",
          "source": "=loopContext.currentItem",
          "var": "currentItem"
        },
        "currentIteration": {
          "type": "number",
          "description": "The current iteration number (1-based)",
          "scope": "internal",
          "source": "=loopContext.currentIteration",
          "var": "currentIteration"
        },
        "collection": {
          "type": "array",
          "description": "The collection being iterated over",
          "scope": "internal",
          "source": "=loopContext.collection",
          "var": "collection"
        },
        "output": {
          "type": "array",
          "description": "Aggregated results from all loop iterations",
          "scope": "external",
          "source": "=loopContext.output",
          "var": "output",
          "schema": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "project": {
                  "type": "string"
                },
                "file": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "errorMessage": {
                  "type": "string"
                },
                "hypothesis": {
                  "type": "string"
                },
                "prUrl": {
                  "type": "string"
                },
                "reproduced": {
                  "type": "boolean"
                },
                "fixVerified": {
                  "type": "boolean"
                },
                "failed": {
                  "type": "boolean"
                },
                "siblings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "relatedPrs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "state": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string"
                      },
                      "number": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "recordResult": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "additionalProperties": true
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          },
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "callVmAgent",
      "type": "uipath.core.flow.4a7879cf-7494-4ada-9e83-ea487a4b55cb",
      "typeVersion": "1.0.0",
      "display": {
        "label": "VmAgent",
        "icon": "flow-project"
      },
      "inputs": {
        "repoUrl": {
          "type": "jsExpression",
          "expression": "$vars.start.output.repoUrl || 'https://github.com/UiPath/flow-workbench'",
          "fieldType": "string"
        },
        "branch": {
          "type": "jsExpression",
          "expression": "$vars.start.output.branch || 'develop'",
          "fieldType": "string"
        },
        "testCommand": {
          "type": "jsExpression",
          "expression": "$vars.investigate.currentItem['testCommand']",
          "fieldType": "string"
        },
        "maxFixAttempts": {
          "type": "literal",
          "expression": "3",
          "fieldType": "number"
        },
        "smokeOnly": {
          "type": "literal",
          "expression": "false",
          "fieldType": "boolean"
        },
        "resumeRunId": {
          "type": "literal",
          "expression": "",
          "fieldType": "string"
        },
        "runnerRepoUrl": {
          "type": "literal",
          "expression": "https://github.com/david-rios-uipath/vm-agent-investigator",
          "fieldType": "string"
        },
        "runnerRef": {
          "type": "literal",
          "expression": "master",
          "fieldType": "string"
        },
        "claudeModel": {
          "type": "jsExpression",
          "expression": "$vars.start.output.claudeModel || 'claude-sonnet-5'",
          "fieldType": "string"
        },
        "errorHandlingEnabled": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "source": "=this",
          "var": "output",
          "schema": {
            "type": "object",
            "properties": {
              "hypothesis": {
                "type": "string",
                "title": "hypothesis"
              },
              "evidence": {
                "type": "string",
                "title": "evidence"
              },
              "reproduced": {
                "type": "boolean",
                "title": "reproduced"
              },
              "fixVerified": {
                "type": "boolean",
                "title": "fixVerified"
              },
              "prUrl": {
                "type": "string",
                "title": "prUrl"
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the flow fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "parentId": "investigate"
    },
    {
      "id": "recordResult",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Record result",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "fieldType": "string",
          "expression": "const t = $vars.investigate.currentItem;\nconst r = ($vars.callVmAgent && $vars.callVmAgent.output) || null;\nconst e = ($vars.callVmAgent && $vars.callVmAgent.error) || null;\nconst base = (p) => String(p || '').split('/').pop().replace(/\\.(spec|test)?\\.?tsx?$/i, '').replace(/\\.[a-z]+$/i, '').toLowerCase();\nconst words = new Set();\nfor (const m of String((r && r.hypothesis) || '').matchAll(/\\b([A-Za-z][A-Za-z0-9-]+)\\.(tsx?|ts|css)\\b|\\b([A-Z][A-Za-z0-9]+(?:Page|Dialog|Panel|Rail|Service|Client|Store))\\b/g)) words.add((m[1] || m[3]).toLowerCase());\nconst relatedPrs = (($vars.pickTests.output || {}).prs || []).filter(pr => (pr.files || []).some(x => words.has(base(x)))).map(pr => ({ number: pr.number, title: pr.title, url: pr.url, state: pr.state || 'open' }));\nreturn {\n  project: t.project, file: t.file, title: t.title, siblings: t.siblings || [],\n  reproduced: !!(r && r.reproduced), fixVerified: !!(r && r.fixVerified),\n  prUrl: (r && r.prUrl) || '', hypothesis: (r && r.hypothesis) || '',\n  failed: !r || !!e, relatedPrs, errorMessage: e ? String(e.message || e.code || 'VmAgent faulted') : ''\n};"
        }
      },
      "outputs": {
        "output": {
          "type": "any",
          "source": "=result.response",
          "var": "output",
          "description": "The return value of the script",
          "schema": {
            "type": "object",
            "properties": {
              "project": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "reproduced": {
                "type": "boolean"
              },
              "fixVerified": {
                "type": "boolean"
              },
              "prUrl": {
                "type": "string"
              },
              "hypothesis": {
                "type": "string"
              },
              "failed": {
                "type": "boolean"
              },
              "errorMessage": {
                "type": "string"
              },
              "siblings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "relatedPrs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "number": {
                      "type": "number"
                    },
                    "title": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "state": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      },
      "parentId": "investigate"
    },
    {
      "id": "summarize",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Summarize",
        "subLabel": "build Slack markdown digest",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "fieldType": "string",
          "expression": "const s = $vars.start.output;\nconst sel = $vars.pickTests.output || { total: 0, totalTests: 0, skipped: 0, selected: [], covered: [] };\nconst rows = ($vars.investigate.output || []).map(i => { const o = (i && i.recordResult && i.recordResult.output) || i; return o && o.title ? o : null; }).filter(Boolean);\nconst nTests = sel.totalTests || sel.total;\nconst head = `:robot_face: *VmAgent investigated ${rows.length} of ${sel.total} ${String(s.projects || 'studio-*,vsix-*').replace(/-?\\*/g, '').replace(/,/g, '/')} failure groups* (${nTests} tests, <${s.runUrl}|run ${s.runId}>)` + (s.reportUrl ? ` · <${s.reportUrl}|report>` : '');\nif (sel.total === 0) return { text: `:robot_face: VmAgent: no ${String(s.projects || 'studio-*,vsix-*').replace(/-?\\*/g, '').replace(/,/g, '/')} failures to investigate in <${s.runUrl}|run ${s.runId}>.` };\nconst spec = (f) => String(f).split('/').pop();\nconst lines = rows.map(r => {\n  if (r.failed) return `• \\`${spec(r.file)} › ${r.title}\\` — investigation faulted: ${r.errorMessage}`;\n  const parts = [r.reproduced ? 'reproduced' : 'not reproduced', r.fixVerified ? 'fix verified' : 'no verified fix', r.prUrl ? `<${r.prUrl}|draft PR>` : 'no PR'];\n  for (const pr of (r.relatedPrs || [])) parts.push(`related ${pr.state === 'merged' ? 'merged' : 'open'} <${pr.url}|PR #${pr.number}>`);\n  const sib = (r.siblings && r.siblings.length) ? ` (+${r.siblings.length} same cause: ${r.siblings.map(x => '`' + x + '`').join(', ')})` : '';\n  return `• \\`${spec(r.file)} › ${r.title}\\`${sib} — ${parts.join(', ')}` + (r.hypothesis ? `\\n    _${r.hypothesis.slice(0, 300)}_` : '');\n});\nfor (const c of (sel.covered || [])) {\n  const sib = (c.siblings && c.siblings.length) ? ` (+${c.siblings.length} same cause)` : '';\n  const verb = c.coveredBy.state === 'merged' ? 'likely already fixed by merged' : 'not investigated: open';\n  lines.push(`• \\`${spec(c.file)} › ${c.title}\\`${sib} — ${verb} <${c.coveredBy.url}|PR #${c.coveredBy.number}> (touches \\`${c.coveredBy.file.split('/').pop()}\\`)`);\n}\nif (sel.skipped > 0) lines.push(`_${sel.skipped} not investigated (maxTests=${s.maxTests})_`);\nreturn { text: [head, ...lines].join('\\n') };\n"
        }
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
          "schema": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End",
        "subLabel": "",
        "icon": "circle-check"
      },
      "inputs": {}
    },
    {
      "id": "replyInSlackThread1",
      "type": "uipath.connector.uipath-salesforce-slack.send-message-to-channel",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply in Slack thread",
        "subLabel": "",
        "icon": "https://alpha.uipath.com/elements_/scaleunit_/3854d037-4ab5-4881-909b-968c433f6d88/v3/element/elements/uipath-salesforce-slack/image"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-salesforce-slack",
          "connectionId": "ccf82d4b-3c2a-492f-bf8f-939b565366a2",
          "connectionResourceId": "ccf82d4b-3c2a-492f-bf8f-939b565366a2",
          "connectionFolderKey": null,
          "method": "POST",
          "endpoint": "/send_message_to_channel_v2",
          "queryParameters": {
            "send_as": "user"
          },
          "bodyParameters": {
            "channel": "C0AH25MT3L5",
            "messageToSend": "=js:($vars.summarize.output['text'])",
            "thread_ts": "=js:($vars.start.output.slackTs || undefined)",
            "mrkdwn": true
          },
          "objectName": "send_message_to_channel_v2",
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"2.14.8\",\"executionType\":null,\"scriptRef\":null,\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-salesforce-slack\",\"objectName\":\"send_message_to_channel_v2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"send_message_to_channel_v2\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/send_message_to_channel_v2\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_send_message_to_channel_v2\"},\"optionalConfiguration\":{\"_textBlocks\":[{\"name\":\"defaultMessage\",\"text\":\"Up to 5 button actions, separated by semicolons. Each button is comma-separated: action ID (unique, required), action name (required), style (primary/danger), confirmation title, confirmation text, confirm ok title, confirm deny title.\\n\\nExample: approve,Approve,primary;reject,Reject,danger and with confirmation dialog: approve,Approve,primary,Confirm,Are you sure?,Yes,No;reject,Reject,danger. Refer activity help docs for more info\"},{\"name\":\"defaultMessage\",\"text\":\"Displays name-value pairs in a two-column layout. Provide field names and values separated by a semicolon.\\n\\nExample: Name: John Doe; Age: 30; Location: New York.\"}],\"objectActions\":[],\"connectorName\":\"Slack\",\"agentIdentity\":null,\"maxPageSize\":1000,\"jobArguments\":null,\"isAutopilotInvalidConfig\":false,\"additionalHeaders\":null,\"cachedLookupValues\":[[\"send_as\",[{\"id\":\"user\",\"displayColumns\":[\"User\",\"user\"],\"stringFormatDisplayColumns\":\"{0}\"}]],[\"channel\",[{\"id\":\"C0AH25MT3L5\",\"displayColumns\":[\"flow-dev-frontend\",\"C0AH25MT3L5\"],\"stringFormatDisplayColumns\":\"\"}]]],\"cachedBrowserItems\":[],\"cachedPropertyMappings\":[],\"primaryKeys\":[],\"objectDisplayName\":\"Send message to channel\",\"baseObj