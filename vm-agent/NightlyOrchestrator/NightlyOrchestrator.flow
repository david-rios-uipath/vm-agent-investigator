{
  "id": "5567126c-2bce-4e36-9246-ce0a46278c73",
  "version": "1.9",
  "name": "NightlyOrchestrator",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "e9d564fb-68e7-4326-8f6f-b9d9a8c5d326",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "selectTests",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Select tests",
        "subLabel": "filter by project, dedupe, cap at maxTests",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "fieldType": "string",
          "expression": "const s = $vars.start.output;\nconst globs = String(s.projects || 'studio-*').split(',').map(g => g.trim()).filter(Boolean);\nconst matches = (p) => globs.some(g => new RegExp('^' + g.split('*').map(x => x.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&')).join('.*') + '$').test(p));\n// One row per distinct test (same file+title across shards/platforms collapses).\nconst seen = new Set();\nconst rows = [];\nfor (const t of (s.failedTests || [])) {\n  if (!t || !matches(t.project || '')) continue;\n  const key = t.file + '::' + t.title;\n  if (seen.has(key)) continue;\n  seen.add(key);\n  rows.push(t);\n}\nrows.sort((a, b) => (a.file + a.title).localeCompare(b.file + b.title));\n// Tests in the same spec file whose first error line matches (digits/hashes ignored) share a cause.\nconst norm = (e) => String(e || '').replace(/\\x1b\\[[0-9;]*m/g, '').split('\\n').map(l => l.trim()).find(Boolean) || '';\nconst causeKey = (t) => { const n = norm(t.error).replace(/[0-9a-f]{8,}/gi, '#').replace(/\\d+/g, '#').slice(0, 160); return t.file + '::' + (n || ('title:' + t.title)); };\nconst groups = [];\nconst byKey = new Map();\nfor (const t of rows) {\n  const k = causeKey(t);\n  if (byKey.has(k)) { byKey.get(k).siblings.push(t.title); continue; }\n  const g = { ...t, siblings: [] }; byKey.set(k, g); groups.push(g);\n}\nconst grep = (title) => String(title).replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&').replace(/\"/g, '\\\\\"');\nconst max = Number(s.maxTests) > 0 ? Number(s.maxTests) : 1;\nconst selected = groups.slice(0, max).map(t => ({\n  project: t.project, file: t.file, title: t.title, error: t.error || '', siblings: t.siblings,\n  testCommand: `corepack pnpm exec playwright test --config e2e/playwright.config.ts e2e/${t.file} --project ${t.project} --grep \"${grep(t.title)}\"`\n}));\nreturn { selected, skipped: groups.length - selected.length, total: groups.length, totalTests: rows.length };"
        }
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
          "schema": {
            "type": "object",
            "properties": {
              "selected": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "project": {
                      "type": "string"
                    },
                    "file": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "testCommand": {
                      "type": "string"
                    },
                    "siblings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "skipped": {
                "type": "number"
              },
              "total": {
                "type": "number"
              },
              "totalTests": {
                "type": "number"
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "investigate",
      "type": "core.logic.loop",
      "typeVersion": "2.4",
      "display": {
        "label": "Investigate each test",
        "subLabel": "parallel, one VmAgent per test"
      },
      "inputs": {
        "collection": "=js:$vars.selectTests.output['selected']",
        "parallel": true
      }
    },
    {
      "id": "callVmAgent",
      "type": "uipath.core.flow.4a7879cf-7494-4ada-9e83-ea487a4b55cb",
      "typeVersion": "1.0.0",
      "parentId": "investigate",
      "display": {
        "label": "VmAgent"
      },
      "inputs": {
        "repoUrl": {
          "type": "jsExpression",
          "expression": "$vars.start.output.repoUrl || 'https://github.com/UiPath/flow-workbench'",
          "fieldType": "string"
        },
        "branch": {
          "type": "jsExpression",
          "expression": "$vars.start.output.branch || 'develop'",
          "fieldType": "string"
        },
        "testCommand": {
          "type": "jsExpression",
          "expression": "$vars.investigate.currentItem['testCommand']",
          "fieldType": "string"
        },
        "maxFixAttempts": {
          "type": "literal",
          "expression": "3",
          "fieldType": "number"
        },
        "smokeOnly": {
          "type": "literal",
          "expression": "false",
          "fieldType": "boolean"
        },
        "resumeRunId": {
          "type": "literal",
          "expression": "",
          "fieldType": "string"
        },
        "runnerRepoUrl": {
          "type": "literal",
          "expression": "https://github.com/david-rios-uipath/vm-agent-investigator",
          "fieldType": "string"
        },
        "runnerRef": {
          "type": "literal",
          "expression": "master",
          "fieldType": "string"
        },
        "claudeModel": {
          "type": "literal",
          "expression": "",
          "fieldType": "string"
        },
        "errorHandlingEnabled": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "source": "=this",
          "var": "output",
          "schema": {
            "type": "object",
            "properties": {
              "hypothesis": {
                "type": "string",
                "title": "hypothesis"
              },
              "evidence": {
                "type": "string",
                "title": "evidence"
              },
              "reproduced": {
                "type": "boolean",
                "title": "reproduced"
              },
              "fixVerified": {
                "type": "boolean",
                "title": "fixVerified"
              },
              "prUrl": {
                "type": "string",
                "title": "prUrl"
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the flow fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "recordResult",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "parentId": "investigate",
      "display": {
        "label": "Record result",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "fieldType": "string",
          "expression": "const t = $vars.investigate.currentItem;\nconst r = ($vars.callVmAgent && $vars.callVmAgent.output) || null;\nconst e = ($vars.callVmAgent && $vars.callVmAgent.error) || null;\nreturn {\n  project: t.project, file: t.file, title: t.title, siblings: t.siblings || [],\n  reproduced: !!(r && r.reproduced), fixVerified: !!(r && r.fixVerified),\n  prUrl: (r && r.prUrl) || '', hypothesis: (r && r.hypothesis) || '',\n  failed: !r || !!e, errorMessage: e ? String(e.message || e.code || 'VmAgent faulted') : ''\n};"
        }
      },
      "outputs": {
        "output": {
          "type": "any",
          "source": "=result.response",
          "var": "output",
          "description": "The return value of the script",
          "schema": {
            "type": "object",
            "properties": {
              "project": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "reproduced": {
                "type": "boolean"
              },
              "fixVerified": {
                "type": "boolean"
              },
              "prUrl": {
                "type": "string"
              },
              "hypothesis": {
                "type": "string"
              },
              "failed": {
                "type": "boolean"
              },
              "errorMessage": {
                "type": "string"
              },
              "siblings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "summarize",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Summarize",
        "subLabel": "build Slack mrkdwn digest",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "fieldType": "string",
          "expression": "const s = $vars.start.output;\nconst sel = $vars.selectTests.output || { total: 0, skipped: 0, selected: [] };\nconst rows = ($vars.investigate.output || []).map(i => { const o = (i && i.recordResult && i.recordResult.output) || i; return o && o.title ? o : null; }).filter(Boolean);\nconst nTests = sel.totalTests || sel.total;\nconst head = `:robot_face: *VmAgent investigated ${rows.length} of ${sel.total} ${s.projects || 'studio-*'} failure groups* (${nTests} tests, <${s.runUrl}|run ${s.runId}>)` + (s.reportUrl ? ` · <${s.reportUrl}|report>` : '');\nif (sel.total === 0) return { text: `:robot_face: VmAgent: no ${s.projects || 'studio-*'} failures to investigate in <${s.runUrl}|run ${s.runId}>.` };\nconst spec = (f) => String(f).split('/').pop();\nconst lines = rows.map(r => {\n  if (r.failed) return `• \\`${spec(r.file)} › ${r.title}\\` — investigation faulted: ${r.errorMessage}`;\n  const parts = [r.reproduced ? 'reproduced' : 'not reproduced', r.fixVerified ? 'fix verified' : 'no verified fix', r.prUrl ? `<${r.prUrl}|draft PR>` : 'no PR'];\n  const sib = (r.siblings && r.siblings.length) ? ` (+${r.siblings.length} same cause: ${r.siblings.map(x => '`' + x + '`').join(', ')})` : '';\n  return `• \\`${spec(r.file)} › ${r.title}\\`${sib} — ${parts.join(', ')}` + (r.hypothesis ? `\\n    _${r.hypothesis.slice(0, 300)}_` : '');\n});\nif (sel.skipped > 0) lines.push(`_${sel.skipped} not investigated (maxTests=${s.maxTests})_`);\nreturn { text: [head, ...lines].join('\\n') };\n"
        }
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
          "schema": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End",
        "subLabel": "",
        "icon": "circle-check"
      },
      "inputs": {},
      "outputs": {}
    },
    {
      "id": "replyInSlackThread1",
      "type": "uipath.connector.uipath-salesforce-slack.send-message-to-channel",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply in Slack thread"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-salesforce-slack",
          "connectionId": "ccf82d4b-3c2a-492f-bf8f-939b565366a2",
          "connectionResourceId": "ccf82d4b-3c2a-492f-bf8f-939b565366a2",
          "connectionFolderKey": "0b28296b-1f4a-4ea9-a3d5-8b0abaac1cf0",
          "method": "POST",
          "endpoint": "/send_message_to_channel_v2",
          "bodyParameters": {
            "channel": "C0AH25MT3L5",
            "messageToSend": "=js:$vars.summarize.output['text']",
            "thread_ts": "=js:$vars.start.output.slackTs || undefined",
            "mrkdwn": true
          },
          "queryParameters": {
            "send_as": "user"
          },
          "uiPathActivityTypeId": "37a305b2-89b1-315d-b73f-1778839a6c47",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"2.14.8\",\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-salesforce-slack\",\"objectName\":\"send_message_to_channel_v2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"send_message_to_channel_v2\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/send_message_to_channel_v2\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_send_message_to_channel_v2\"}}"
        }
      }
    }
  ],
  "edges": [
