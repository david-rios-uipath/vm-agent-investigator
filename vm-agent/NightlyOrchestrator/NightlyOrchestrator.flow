          "boundary": "inner",
          "handles": [
            {
              "id": "start",
              "label": "start",
              "type": "source",
              "handleType": "output"
            }
          ]
        },
        {
          "position": "right",
          "boundary": "inner",
          "handles": [
            {
              "id": "continue",
              "label": "continue",
              "type": "target",
              "handleType": "input"
            },
            {
              "id": "break",
              "label": "break",
              "type": "target",
              "handleType": "input",
              "visible": "inputs.breakEnabled"
            }
          ]
        }
      ],
      "model": {
        "type": "bpmn:SubProcess"
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "collection": {
            "type": "array"
          },
          "parallel": {
            "type": "boolean"
          },
          "completionCondition": {
            "type": "string"
          },
          "breakEnabled": {
            "type": "boolean"
          }
        },
        "required": [
          "collection"
        ]
      },
      "inputDefaults": {
        "collection": [],
        "parallel": false,
        "completionCondition": "",
        "breakEnabled": false
      },
      "outputDefinition": {
        "currentItem": {
          "type": "any",
          "description": "The current item being iterated in the loop",
          "source": "=loopContext.currentItem",
          "var": "currentItem",
          "scope": "internal"
        },
        "currentIteration": {
          "type": "number",
          "description": "The current iteration number (1-based)",
          "source": "=loopContext.currentIteration",
          "var": "currentIteration",
          "scope": "internal"
        },
        "collection": {
          "type": "array",
          "description": "The collection being iterated over",
          "source": "=loopContext.collection",
          "var": "collection",
          "scope": "internal"
        },
        "output": {
          "type": "array",
          "description": "Aggregated results from all loop iterations",
          "source": "=loopContext.output",
          "var": "output",
          "scope": "external"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "form": {
        "id": "loop-properties",
        "title": "Loop configuration",
        "sections": [
          {
            "id": "iteration",
            "title": "Iteration",
            "fields": [
              {
                "name": "inputs.collection",
                "type": "custom",
                "component": "code-editor",
                "label": "Collection",
                "description": "The loop runs once for each item in this array or collection.",
                "componentProps": {
                  "singleLine": true,
                  "mode": "expression",
                  "toggleable": false,
                  "placeholder": "$vars.scriptTask1.output",
                  "showVariableButton": true,
                  "language": "javascript",
                  "expectedType": "array",
                  "validationMode": "expression"
                }
              },
              {
                "name": "inputs.parallel",
                "type": "switch",
                "label": "Parallel",
                "description": "The loop runs iterations at the same time."
              },
              {
                "name": "inputs.completionCondition",
                "type": "custom",
                "component": "code-editor",
                "label": "Break on condition",
                "description": "The loop exits early when this condition becomes true after an iteration completes.",
                "componentProps": {
                  "singleLine": true,
                  "mode": "expression",
                  "toggleable": false,
                  "placeholder": "$vars.processedCount >= 5",
                  "showVariableButton": true,
                  "alwaysIncludeSelf": true,
                  "returnType": "boolean",
                  "validationMode": "expression",
                  "language": "javascript"
                }
              },
              {
                "name": "inputs.breakEnabled",
                "type": "switch",
                "label": "Show break handle",
                "description": "Nodes inside the loop can exit through a break handle."
              }
            ]
          }
        ]
      }
    },
