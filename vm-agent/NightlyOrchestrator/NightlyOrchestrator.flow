:false},{\"path\":\"attachments[*].actions[*].confirm.title\",\"required\":false},{\"path\":\"attachments[*].actions[*].name\",\"required\":false},{\"path\":\"attachments[*].actions[*].style\",\"required\":false},{\"path\":\"attachments[*].actions[*].text\",\"required\":false},{\"path\":\"attachments[*].actions[*].type\",\"required\":false},{\"path\":\"attachments[*].actions[*].value\",\"required\":false},{\"path\":\"attachments[*].attachment_type\",\"required\":false},{\"path\":\"attachments[*].callback_id\",\"required\":false},{\"path\":\"attachments[*].color\",\"required\":false},{\"path\":\"attachments[*].fallback\",\"required\":false},{\"path\":\"attachments[*].text\",\"required\":false}],\"clrType\":{\"_elementType\":null,\"_isNullable\":false,\"isArray\":true,\"genericTypeArguments\":[],\"fullName\":null,\"name\":\"Object\",\"assemblyQualifiedName\":\"Object[*]\",\"isValueType\":false},\"forceExpressionEditor\":false,\"requiredGroups\":null,\"disableExpressions\":false,\"backingField\":null,\"searchableDisplayName\":null,\"selectedResourceId\":null}],\"outputFields\":[{\"typeScriptDefinition\":null,\"useUrlInput\":false,\"id\":\"out_ts\",\"name\":\"ts\",\"displayName\":\"Message timestamp\",\"description\":\"The ID (timestamp) of the message sent\",\"type\":\"string\",\"primaryKey\":false,\"design\":{\"loadByDefault\":false,\"isMultiSelect\":false,\"enableUserOverride\":false,\"isHidden\":false,\"validation\":false},\"fieldActions\":null,\"searchable\":false,\"searchableJoins\":null,\"required\":false,\"request\":false,\"response\":true,\"responseCurated\":true,\"fieldLocation\":\"output\",\"onCanvas\":null,\"isJitField\":false,\"isFieldActionParent\":false,\"isMainResponseField\":false,\"isMethodParameter\":false,\"isBackgroundField\":false,\"filterTree\":null,\"filterNeedsRefresh\":null,\"arrayInputPaths\":null,\"clrType\":{\"_elementType\":null,\"_isNullable\":true,\"isArray\":false,\"genericTypeArguments\":[],\"fullName\":null,\"name\":\"String\",\"assemblyQualifiedName\":\"String\",\"isValueType\":true},\"forceExpressionEditor\":false,\"requiredGroups\":null,\"disableExpressions\":false,\"backingField\":null,\"searchableDisplayName\":null,\"selectedResourceId\":null,\"sampleValue\":\"1631092102.000400\"},{\"typeScriptDefinition\":null,\"useUrlInput\":false,\"id\":\"send_message_to_channel_v2\",\"name\":\"send_message_to_channel_v2\",\"displayName\":\"Channel\",\"description\":\"The output send chat message\",\"type\":\"Generatedsend_message_to_channel_v2\",\"sortOrder\":null,\"format\":null,\"mask\":null,\"defaultValue\":null,\"primaryKey\":false,\"lookup\":null,\"enum\":null,\"design\":null,\"fieldActions\":null,\"searchable\":false,\"searchableOperators\":null,\"searchableNames\":null,\"searchableJoins\":null,\"required\":false,\"request\":false,\"response\":true,\"responseCurated\":false,\"fieldLocation\":\"output\",\"onCanvas\":null,\"isJitField\":true,\"isFieldActionParent\":false,\"isMainResponseField\":false,\"isMethodParameter\":false,\"isBackgroundField\":false,\"filterTree\":null,\"filterNeedsRefresh\":null,\"arrayInputPaths\":null,\"clrType\":{\"_elementType\":null,\"_isNullable\":false,\"isArray\":false,\"genericTypeArguments\":[],\"fullName\":null,\"name\":\"Object\",\"assemblyQualifiedName\":\"Object\",\"isValueType\":false},\"forceExpressionEditor\":false,\"requiredGroups\":null,\"disableExpressions\":false,\"backingField\":null,\"searchableDisplayName\":null,\"selectedResourceId\":null}],\"jitTypeNeedsRefresh\":false,\"jitInputField\":{\"typeScriptDefinition\":\"{\\\"attachment\\\":{\\\"color\\\":string;\\\"image_url\\\":string;\\\"text\\\":string;\\\"title\\\":string;\\\"title_link\\\":string};\\\"attachments\\\":{\\\"actions\\\":{\\\"confirm\\\":{\\\"dismiss_text\\\":string;\\\"ok_text\\\":string;\\\"text\\\":string;\\\"title\\\":string};\\\"name\\\":string;\\\"style\\\":string;\\\"text\\\":string;\\\"type\\\":string;\\\"value\\\":string}[];\\\"attachment_type\\\":string;\\\"callback_id\\\":string;\\\"color\\\":string;\\\"fallback\\\":string;\\\"text\\\":string}[];\\\"buttons\\\":string;\\\"channel\\\":string;\\\"fields\\\":string;\\\"icon_emoji\\\":string;\\\"icon_url\\\":string;\\\"image\\\":string;\\\"link_names\\\":boolean;\\\"messageToSend\\\":string;\\\"metadata\\\":{\\\"event_payload\\\":{\\\"id\\\":string;\\\"title\\\":string};\\\"event_type\\\":string};\\\"mrkdwn\\\":boolean;\\\"parse\\\":string;\\\"reply_broadcast\\\":boolean;\\\"thread_ts\\\":string;\\\"unfurl_links\\\":boolean;\\\"unfurl_media\\\":boolean;\\\"username\\\":string}\",\"useUrlInput\":false,\"id\":\"in_send_message_to_channel_v2\",\"name\":\"send_message_to_channel_v2\",\"displayName\":\"Channel\",\"description\":\"'Channel' input object\",\"type\":\"Generatedsend_message_to_channel_v2\",\"sortOrder\":null,\"format\":null,\"mask\":null,\"defaultValue\":\"{\\n  \\\"attachment\\\": {\\n    \\\"color\\\": null,\\n    \\\"image_url\\\": null,\\n    \\\"text\\\": null,\\n    \\\"title\\\": null,\\n    \\\"title_link\\\": null\\n  },\\n  \\\"attachments\\\": [\\n    {\\n      \\\"actions\\\": [\\n        {\\n          \\\"confirm\\\": {\\n            \\\"dismiss_text\\\": null,\\n            \\\"ok_text\\\": null,\\n            \\\"text\\\": null,\\n            \\\"title\\\": null\\n          },\\n          \\\"name\\\": null,\\n          \\\"style\\\": null,\\n          \\\"text\\\": null,\\n          \\\"type\\\": null,\\n          \\\"value\\\": null\\n        }\\n      ],\\n      \\\"attachment_type\\\": null,\\n      \\\"callback_id\\\": null,\\n      \\\"color\\\": null,\\n      \\\"fallback\\\": null,\\n      \\\"text\\\": null\\n    }\\n  ],\\n  \\\"buttons\\\": null,\\n  \\\"channel\\\": null,\\n  \\\"fields\\\": null,\\n  \\\"icon_emoji\\\": null,\\n  \\\"icon_url\\\": null,\\n  \\\"image\\\": null,\\n  \\\"link_names\\\": null,\\n  \\\"messageToSend\\\": null,\\n  \\\"metadata\\\": {\\n    \\\"event_payload\\\": {\\n      \\\"id\\\": null,\\n      \\\"title\\\": null\\n    },\\n    \\\"event_type\\\": null\\n  },\\n  \\\"mrkdwn\\\": null,\\n  \\\"parse\\\": null,\\n  \\\"reply_broadcast\\\": null,\\n  \\\"thread_ts\\\": null,\\n  \\\"unfurl_links\\\": null,\\n  \\\"unfurl_media\\\": null,\\n  \\\"username\\\": null\\n}\",\"primaryKey\":false,\"lookup\":null,\"enum\":null,\"design\":null,\"fieldActions\":null,\"searchable\":false,\"searchableOperators\":null,\"searchableNames\":null,\"searchableJoins\":null,\"required\":true,\"request\":false,\"response\":false,\"responseCurated\":false,\"fieldLocation\":\"jitObjectInput\",\"onCanvas\":null,\"isJitField\":true,\"isFieldActionParent\":false,\"isMainResponseField\":false,\"isMethodParameter\":false,\"isBackgroundField\":false,\"filterTree\":null,\"filterNeedsRefresh\":null,\"arrayInputPaths\":null,\"clrType\":{\"_elementType\":null,\"_isNullable\":false,\"isArray\":false,\"genericTypeArguments\":[],\"fullName\":null,\"name\":\"Object\",\"assemblyQualifiedName\":\"Object\",\"isValueType\":false},\"forceExpressionEditor\":false,\"requiredGroups\":null,\"disableExpressions\":false,\"backingField\":null,\"searchableDisplayName\":null,\"selectedResourceId\":null},\"inputMode\":null,\"searchableFields\":[],\"hasUnifiedTypes\":true,\"jitTypeHash\":null}}}",
          "uiPathActivityTypeId": "37a305b2-89b1-315d-b73f-1778839a6c47",
          "errorState": {
            "issues": []
          },
          "telemetryData": {
