    {
      "id": "pickTests",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Pick tests",
        "subLabel": "skip groups an open PR already touches, cap at maxTests",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "fieldType": "string",
          "expression": "const s = $vars.start.output;\nconst sel = $vars.selectTests.output || { groups: [], total: 0, totalTests: 0 };\nconst base = (path) => String(path || '').split('/').pop().replace(/\\.(spec|test)?\\.?tsx?$/i, '').replace(/\\.[a-z]+$/i, '').toLowerCase();\nconst prList = ((($vars.parsePrs || {}).output || {}).prs || []).filter(p => p && p.number).map(p => ({ number: p.number, title: p.title || '', url: p.url || '', state: p.state || 'open', files: (p.files || []).map(String) }));\n// A group is covered when an open PR touches its spec file or a page object named in its error.\nconst tokens = (t) => {\n  const set = new Set([base(t.file)]);\n  const first = String(t.error || '').split('\\n')[0];\n  for (const m of first.matchAll(/\\b([A-Z][A-Za-z0-9]+(?:Page|Dialog|Panel|Rail|Service|Client|Store))\\b/g)) set.add(m[1].toLowerCase());\n  return set;\n};\nconst covered = [];\nconst open = [];\nfor (const t of sel.groups || []) {\n  const tk = tokens(t);\n  let hit = null;\n  for (const pr of prList) {\n    const f = pr.files.find(x => base(x) === base(t.file) || tk.has(base(x)));\n    if (f) { hit = { number: pr.number, title: pr.title, url: pr.url, state: pr.state, file: f }; break; }\n  }\n  if (hit) covered.push({ ...t, coveredBy: hit }); else open.push(t);\n}\nconst max = Number(s.maxTests) > 0 ? Number(s.maxTests) : 1;\nconst selected = open.slice(0, max);\nreturn { selected, covered, skipped: open.length - selected.length, total: sel.total, totalTests: sel.totalTests, prs: prList };"
        }
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
          "schema": {
            "type": "object",
            "properties": {
              "selected": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "project": {
                      "type": "string"
                    },
                    "file": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "testCommand": {
                      "type": "string"
                    },
                    "siblings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "covered": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "project": {
                      "type": "string"
                    },
                    "file": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "testCommand": {
                      "type": "string"
                    },
                    "siblings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "coveredBy": {
                      "type": "object",
                      "properties": {
                        "number": {
                          "type": "number"
                        },
                        "title": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string"
                        },
                        "file": {
                          "type": "string"
                        },
                        "state": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "skipped": {
                "type": "number"
              },
              "total": {
                "type": "number"
              },
              "totalTests": {
                "type": "number"
              },
              "prs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "number": {
                      "type": "number"
                    },
                    "title": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "files": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "state": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "ghPrs",
      "type": "uipath.core.rpa-workflow.ca36341d-ecec-4ba6-aa76-134d0afe4ba7",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Recent PRs (GitHub API on the VM)",
        "subLabel": "open 14d or merged 48h, with changed files",
        "icon": "rpa"
      },
      "inputs": {
        "Script": {
          "type": "literal",
          "expression": "$ErrorActionPreference = 'Stop'\n[Net.ServicePointManager]::SecurityProtocol = 'Tls12'\n# Open PRs may fix a failing test; a PR merged after the nightly's commit already has. Output is one compact\n# ASCII line so the flow can parse it; the raw GitHub payloads are far too big for Maestro instance variables.\n$h = @{ 'User-Agent' = 'vm-agent'; 'Accept' = 'application/vnd.github+json' }\nif ($env:GH_TOKEN) { $h['Authorization'] = \"token $($env:GH_TOKEN)\" }\n$repo = 'UiPath/flow-workbench'\n$out = @()\ntry {\n  $pulls = Invoke-RestMethod -Headers $h -Uri \"https://api.github.com/repos/$repo/pulls?state=all&sort=updated&direction=desc&per_page=40\"\n  $now = [DateTime]::UtcNow\n  foreach ($p in $pulls) {\n    $keep = $false\n    if ($p.state -eq 'open') { $keep = ([DateTime]$p.updated_at) -gt $now.AddDays(-14) }\n    elseif ($p.merged_at) { $keep = ([DateTime]$p.merged_at) -gt $now.AddHours(-48) }\n    if (-not $keep) { continue }\n    $files = @()\n    try { $files = @(Invoke-RestMethod -Headers $h -Uri \"https://api.github.com/repos/$repo/pulls/$($p.number)/files?per_page=100\" | ForEach-Object { $_.filename }) } catch { Write-Output \"[prcheck] files of #$($p.number): $_\" }\n    # Compact: vm-exec returns only the last 32000 chars of stdout. Basenames are what the flow matches on.\n    $names = @($files | ForEach-Object { ($_ -split '/')[-1] } | Select-Object -Unique)\n    $title = if ($p.title.Length -gt 80) { $p.title.Substring(0, 80) } else { $p.title }\n    $out += [pscustomobject]@{ n = $p.number; t = $title; s = $(if ($p.merged_at) { 'm' } else { 'o' }); f = $names }\n  }\n} catch { Write-Output \"[prcheck] $_\" }\n$json = if ($out.Count -eq 0) { '[]' } elseif ($out.Count -eq 1) { '[' + ($out[0] | ConvertTo-Json -Compress -Depth 5) + ']' } else { $out | ConvertTo-Json -Compress -Depth 5 }\n$json = [regex]::Replace($json, '[^\\x00-\\x7F]', { param($m) '\\u{0:x4}' -f [int][char]$m.Value })\nWrite-Output \"[prcheck] $($out.Count) candidate PRs\"\nWrite-Output \"PRS_JSON=$json\"\nexit 0",
          "fieldType": "string"
        },
        "WorkDir": {
          "type": "literal",
          "expression": "C:\\vm-agent",
          "fieldType": "string"
        },
        "RunId": {
          "type": "jsExpression",
          "expression": "'prcheck-' + String($vars.start.output.runId || 'manual')",
          "fieldType": "string"
        },
        "StateKey": {
          "type": "literal",
          "expression": "",
          "fieldType": "string"
        },
        "TimeoutMinutes": {
          "type": "literal",
          "expression": "5",
          "fieldType": "number"
        },
        "MaxOutputChars": 32000,
        "errorHandlingEnabled": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "source": "=this",
          "var": "output",
          "schema": {
            "type": "object",
            "properties": {
              "ExitCode": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              "Stdout": {
                "type": "string"
              },
              "OutputBlobPath": {
                "type": "string"
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "parsePrs",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Parse PR list",
        "subLabel": "PRS_JSON= line; absent = no PR check",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "fieldType": "string",
          "expression": "// The VM script prints exactly one PRS_JSON= line, last. Its absence means the check itself failed;\n// the run then continues as if no PR were related.\nconst out = $vars.ghPrs.output || {};\nconst lines = String(out.Stdout || '').split('\\n');\nfor (let i = lines.length - 1; i >= 0; i--) {\n  const l = lines[i].trim();\n  if (l.startsWith('PRS_JSON=')) {\n    try {\n      const raw = JSON.parse(l.slice('PRS_JSON='.length));\n      // Compact keys from the VM: n=number, t=title, s=o|m, f=file basenames.\n      const prs = (Array.isArray(raw) ? raw : []).map(r => ({ number: r.n, title: r.t || '', url: `https://github.com/UiPath/flow-workbench/pull/${r.n}`, state: r.s === 'm' ? 'merged' : 'open', files: (r.f || []).map(String) }));\n      return { prs, ok: true };\n    } catch (e) { break; }\n  }\n}\nreturn { prs: [], ok: false, exitCode: out.ExitCode };"
        }
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
          "schema": {
            "type": "object",
            "properties": {
              "prs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "number": {
                      "type": "number"
                    },
                    "title": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "state": {
                      "type": "string"
                    },
                    "files": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "ok": {
                "type": "boolean"
              },
              "exitCode": {
                "type": "number"
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e-start-selectTests",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "selectTests",
      "targetPort": "input"
    },
    {
      "id": "e_loop_start",
      "sourceNodeId": "investigate",
      "sourcePort": "start",
      "targetNodeId": "callVmAgent",
      "targetPort": "input"
    },
    {
      "id": "e_vm_ok",
      "sourceNodeId": "callVmAgent",
      "sourcePort": "output",
      "targetNodeId": "recordResult",
