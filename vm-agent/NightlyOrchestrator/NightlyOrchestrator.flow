{
  "id": "5567126c-2bce-4e36-9246-ce0a46278c73",
  "version": "1.9",
  "name": "NightlyOrchestrator",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "e9d564fb-68e7-4326-8f6f-b9d9a8c5d326",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "selectTests",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Select tests",
        "subLabel": "dedupe, group by cause",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "fieldType": "string",
          "expression": "const s = $vars.start.output;\nconst globs = String(s.projects || 'studio-*').split(',').map(g => g.trim()).filter(Boolean);\nconst matches = (p) => globs.some(g => new RegExp('^' + g.split('*').map(x => x.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&')).join('.*') + '$').test(p));\n// One row per distinct test (same file+title across shards/platforms collapses).\nconst seen = new Set();\nconst rows = [];\nfor (const t of (s.failedTests || [])) {\n  if (!t || !matches(t.project || '')) continue;\n  const key = t.file + '::' + t.title;\n  if (seen.has(key)) continue;\n  seen.add(key);\n  rows.push(t);\n}\nrows.sort((a, b) => (a.file + a.title).localeCompare(b.file + b.title));\n// Tests whose first error line matches (digits/hashes ignored) share a cause. A named `Error:` groups\n// across spec files (shared infra failure); a bare timeout/locator message only within its file.\nconst norm = (e) => String(e || '').replace(/\\x1b\\[[0-9;]*m/g, '').split('\\n').map(l => l.trim()).find(Boolean) || '';\nconst causeKey = (t) => {\n  const n = norm(t.error).replace(/[0-9a-f]{8,}/gi, '#').replace(/\\d+/g, '#').slice(0, 160);\n  if (!n) return t.file + '::title:' + t.title;\n  return /^\\w*Error: /.test(n) && !/^TimeoutError/.test(n) ? 'err::' + n : t.file + '::' + n;\n};\nconst groups = [];\nconst byKey = new Map();\nfor (const t of rows) {\n  const k = causeKey(t);\n  const g = byKey.get(k);\n  if (g) { g.siblings.push(g.file === t.file ? t.title : `${t.file.split('/').pop()} › ${t.title}`); continue; }\n  const ng = { ...t, siblings: [] }; byKey.set(k, ng); groups.push(ng);\n}\n// Biggest cause first: it explains the most red.\ngroups.sort((a, b) => b.siblings.length - a.siblings.length);\nconst grep = (title) => String(title).replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&').replace(/\"/g, '\\\\\"');\nconst groups2 = groups.map(t => ({\n  project: t.project, file: t.file, title: t.title, error: t.error || '', siblings: t.siblings,\n  testCommand: `corepack pnpm exec playwright test --config e2e/playwright.config.ts e2e/${t.file} --project ${t.project} --grep \"${grep(t.title)}\"`\n}));\nreturn { groups: groups2, total: groups2.length, totalTests: rows.length };"
        }
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
          "schema": {
            "type": "object",
            "properties": {
              "total": {
                "type": "number"
              },
              "totalTests": {
                "type": "number"
              },
              "groups": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "project": {
                      "type": "string"
                    },
                    "file": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "testCommand": {
                      "type": "string"
                    },
                    "siblings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "investigate",
      "type": "core.logic.loop",
      "typeVersion": "2.4",
      "display": {
        "label": "Investigate each test",
        "subLabel": "parallel, one VmAgent per test"
      },
      "inputs": {
        "collection": "=js:$vars.pickTests.output['selected']",
        "parallel": true
      }
    },
    {
      "id": "callVmAgent",
      "type": "uipath.core.flow.4a7879cf-7494-4ada-9e83-ea487a4b55cb",
      "typeVersion": "1.0.0",
      "parentId": "investigate",
      "display": {
        "label": "VmAgent"
      },
      "inputs": {
        "repoUrl": {
          "type": "jsExpression",
          "expression": "$vars.start.output.repoUrl || 'https://github.com/UiPath/flow-workbench'",
          "fieldType": "string"
        },
        "branch": {
          "type": "jsExpression",
          "expression": "$vars.start.output.branch || 'develop'",
          "fieldType": "string"
        },
        "testCommand": {
          "type": "jsExpression",
          "expression": "$vars.investigate.currentItem['testCommand']",
          "fieldType": "string"
        },
        "maxFixAttempts": {
          "type": "literal",
          "expression": "3",
          "fieldType": "number"
        },
        "smokeOnly": {
          "type": "literal",
          "expression": "false",
          "fieldType": "boolean"
        },
        "resumeRunId": {
          "type": "literal",
          "expression": "",
          "fieldType": "string"
        },
        "runnerRepoUrl": {
          "type": "literal",
          "expression": "https://github.com/david-rios-uipath/vm-agent-investigator",
          "fieldType": "string"
        },
        "runnerRef": {
          "type": "literal",
          "expression": "master",
          "fieldType": "string"
        },
        "claudeModel": {
          "type": "literal",
          "expression": "",
          "fieldType": "string"
        },
        "errorHandlingEnabled": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "source": "=this",
          "var": "output",
          "schema": {
            "type": "object",
            "properties": {
              "hypothesis": {
                "type": "string",
                "title": "hypothesis"
              },
              "evidence": {
                "type": "string",
                "title": "evidence"
              },
              "reproduced": {
                "type": "boolean",
                "title": "reproduced"
              },
              "fixVerified": {
                "type": "boolean",
                "title": "fixVerified"
              },
              "prUrl": {
                "type": "string",
                "title": "prUrl"
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the flow fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "recordResult",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "parentId": "investigate",
      "display": {
        "label": "Record result",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "fieldType": "string",
          "expression": "const t = $vars.investigate.currentItem;\nconst r = ($vars.callVmAgent && $vars.callVmAgent.output) || null;\nconst e = ($vars.callVmAgent && $vars.callVmAgent.error) || null;\nconst base = (p) => String(p || '').split('/').pop().replace(/\\.(spec|test)?\\.?tsx?$/i, '').replace(/\\.[a-z]+$/i, '').toLowerCase();\nconst words = new Set();\nfor (const m of String((r && r.hypothesis) || '').matchAll(/\\b([A-Za-z][A-Za-z0-9-]+)\\.(tsx?|ts|css)\\b|\\b([A-Z][A-Za-z0-9]+(?:Page|Dialog|Panel|Rail|Service|Client|Store))\\b/g)) words.add((m[1] || m[3]).toLowerCase());\nconst relatedPrs = (($vars.pickTests.output || {}).prs || []).filter(pr => (pr.files || []).some(x => words.has(base(x)))).map(pr => ({ number: pr.number, title: pr.title, url: pr.url }));\nreturn {\n  project: t.project, file: t.file, title: t.title, siblings: t.siblings || [],\n  reproduced: !!(r && r.reproduced), fixVerified: !!(r && r.fixVerified),\n  prUrl: (r && r.prUrl) || '', hypothesis: (r && r.hypothesis) || '',\n  failed: !r || !!e, relatedPrs, errorMessage: e ? String(e.message || e.code || 'VmAgent faulted') : ''\n};"
        }
      },
      "outputs": {
        "output": {
          "type": "any",
          "source": "=result.response",
          "var": "output",
          "description": "The return value of the script",
          "schema": {
            "type": "object",
            "properties": {
              "project": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "reproduced": {
                "type": "boolean"
              },
              "fixVerified": {
                "type": "boolean"
              },
              "prUrl": {
                "type": "string"
              },
              "hypothesis": {
                "type": "string"
              },
              "failed": {
                "type": "boolean"
              },
              "errorMessage": {
                "type": "string"
              },
              "siblings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "relatedPrs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "number": {
                      "type": "number"
                    },
                    "title": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "summarize",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Summarize",
        "subLabel": "build Slack mrkdwn digest",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "fieldType": "string",
          "expression": "const s = $vars.start.output;\nconst sel = $vars.pickTests.output || { total: 0, skipped: 0, selected: [], covered: [] };\nconst rows = ($vars.investigate.output || []).map(i => { const o = (i && i.recordResult && i.recordResult.output) || i; return o && o.title ? o : null; }).filter(Boolean);\nconst nTests = sel.totalTests || sel.total;\nconst head = `:robot_face: *VmAgent investigated ${rows.length} of ${sel.total} ${String(s.projects || 'studio-*').replace(/-?\\*/g, '')} failure groups* (${nTests} tests, <${s.runUrl}|run ${s.runId}>)` + (s.reportUrl ? ` · <${s.reportUrl}|report>` : '');\nif (sel.total === 0) return { text: `:robot_face: VmAgent: no ${String(s.projects || 'studio-*').replace(/-?\\*/g, '')} failures to investigate in <${s.runUrl}|run ${s.runId}>.` };\nconst spec = (f) => String(f).split('/').pop();\nconst lines = rows.map(r => {\n  if (r.failed) return `• \\`${spec(r.file)} › ${r.title}\\` — investigation faulted: ${r.errorMessage}`;\n  const parts = [r.reproduced ? 'reproduced' : 'not reproduced', r.fixVerified ? 'fix verified' : 'no verified fix', r.prUrl ? `<${r.prUrl}|draft PR>` : 'no PR'];\n  for (const pr of (r.relatedPrs || [])) parts.push(`related open <${pr.url}|PR #${pr.number}>`);\n  const sib = (r.siblings && r.siblings.length) ? ` (+${r.siblings.length} same cause: ${r.siblings.map(x => '`' + x + '`').join(', ')})` : '';\n  return `• \\`${spec(r.file)} › ${r.title}\\`${sib} — ${parts.join(', ')}` + (r.hypothesis ? `\\n    _${r.hypothesis.slice(0, 300)}_` : '');\n});\nfor (const c of (sel.covered || [])) {\n  const sib = (c.siblings && c.siblings.length) ? ` (+${c.siblings.length} same cause)` : '';\n  lines.push(`• \\`${spec(c.file)} › ${c.title}\\`${sib} — not investigated: open <${c.coveredBy.url}|PR #${c.coveredBy.number}> already touches \\`${c.coveredBy.file.split('/').pop()}\\``);\n}\nif (sel.skipped > 0) lines.push(`_${sel.skipped} not investigated (maxTests=${s.maxTests})_`);\nreturn { text: [head, ...lines].join('\\n') };\n"
        }
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
          "schema": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End",
        "subLabel": "",
        "icon": "circle-check"
      },
      "inputs": {},
      "outputs": {}
    },
    {
      "id": "replyInSlackThread1",
      "type": "uipath.connector.uipath-salesforce-slack.send-message-to-channel",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reply in Slack thread"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-salesforce-slack",
          "connectionId": "ccf82d4b-3c2a-492f-bf8f-939b565366a2",
          "connectionResourceId": "ccf82d4b-3c2a-492f-bf8f-939b565366a2",
          "connectionFolderKey": "0b28296b-1f4a-4ea9-a3d5-8b0abaac1cf0",
          "method": "POST",
          "endpoint": "/send_message_to_channel_v2",
          "bodyParameters": {
            "channel": "C0AH25MT3L5",
            "messageToSend": "=js:$vars.summarize.output['text']",
            "thread_ts": "=js:$vars.start.output.slackTs || undefined",
            "mrkdwn": true
          },
          "queryParameters": {
            "send_as": "user"
          },
          "uiPathActivityTypeId": "37a305b2-89b1-315d-b73f-1778839a6c47",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"2.14.8\",\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-salesforce-slack\",\"objectName\":\"send_message_to_channel_v2\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"send_message_to_channel_v2\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/send_message_to_channel_v2\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_send_message_to_channel_v2\"}}"
        }
      }
    },
    {
      "id": "prFiles",
      "type": "core.logic.loop",
      "typeVersion": "2.4",
      "display": {
        "label": "Files of each open PR",
        "subLabel": "parallel"
      },
      "inputs": {
        "collection": "=js:$vars.recentPrs.output['prs']",
        "parallel": true
      },
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "listOpenPrs1",
      "type": "uipath.connector.uipath-microsoft-github.list-records",
      "typeVersion": "1.0.0",
      "display": {
        "label": "List open PRs"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-microsoft-github",
          "connectionId": "3e9ae2b7-85a6-4271-8c23-5a620eed56e3",
          "connectionResourceId": "3e9ae2b7-85a6-4271-8c23-5a620eed56e3",
          "connectionFolderKey": "0b28296b-1f4a-4ea9-a3d5-8b0abaac1cf0",
          "method": "GET",
          "endpoint": "/{repo}/pulls",
          "queryParameters": {
            "state": "open",
            "sort": "updated",
            "direction": "desc",
            "pageSize": "100"
          },
          "pathParameters": {
            "repo": "flow-workbench"
          },
          "uiPathActivityTypeId": "5d6fae7f-1ab5-3727-8c27-6cfa57ded5ed",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"2.6.14\",\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-github\",\"activityType\":\"Generic\",\"version\":\"1.0.0\",\"operation\":\"list\",\"supportsStreaming\":false,\"objectName\":\"pulls\"},\"objectName\":\"pulls\",\"operation\":\"list\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"GET\",\"path\":\"/{repo}/pulls\",\"unifiedTypesCompatible\":true}}",
          "inputMetadata": {
            "operation": "list",
            "pagination": {
              "maxPageSize": 1000
            }
          }
        },
        "errorHandlingEnabled": true
      }
    },
    {
      "id": "listPrFiles1",
      "type": "uipath.connector.uipath-microsoft-github.list-records",
      "typeVersion": "1.0.0",
      "display": {
        "label": "List PR files"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-microsoft-github",
          "connectionId": "3e9ae2b7-85a6-4271-8c23-5a620eed56e3",
          "connectionResourceId": "3e9ae2b7-85a6-4271-8c23-5a620eed56e3",
          "connectionFolderKey": "0b28296b-1f4a-4ea9-a3d5-8b0abaac1cf0",
          "method": "GET",
          "endpoint": "/{repo}/pulls/{pull_number}/files",
          "queryParameters": {
            "pageSize": "100"
          },
          "pathParameters": {
            "repo": "flow-workbench",
            "pull_number": "=js:$vars.prFiles.currentItem[\"number\"]"
          },
          "uiPathActivityTypeId": "5d6fae7f-1ab5-3727-8c27-6cfa57ded5ed",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"2.6.14\",\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"connectorKey\":\"uipath-microsoft-github\",\"activityType\":\"Generic\",\"version\":\"1.0.0\",\"operation\":\"list\",\"supportsStreaming\":false,\"objectName\":\"pulls::files\"},\"objectName\":\"pulls::files\",\"operation\":\"list\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"GET\",\"path\":\"/{repo}/pulls/{pull_number}/files\",\"unifiedTypesCompatible\":true}}",
          "inputMetadata": {
            "operation": "list",
            "pagination": {
              "maxPageSize": 1000
            }
          }
        },
        "errorHandlingEnabled": true
      },
      "parentId": "prFiles"
    },
    {
      "id": "pickTests",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Pick tests",
        "subLabel": "skip groups an open PR already touches, cap at maxTests",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "fieldType": "string",
          "expression": "const s = $vars.start.output;\nconst sel = $vars.selectTests.output || { groups: [], total: 0, totalTests: 0 };\n// Connector payloads may arrive camelCase or PascalCase; read either.\nconst g = (o, k) => (o == null ? undefined : (o[k] !== undefined ? o[k] : o[k.charAt(0).toUpperCase() + k.slice(1)]));\nconst base = (path) => String(path || '').split('/').pop().replace(/\\.(spec|test)?\\.?tsx?$/i, '').replace(/\\.[a-z]+$/i, '').toLowerCase();\nconst prList = ($vars.prFiles.output || [])\n  .map(it => (it && it.prFileNames && it.prFileNames.output) || (it && it.files ? it : null))\n  .filter(p => p && p.number)\n  .map(p => ({ number: p.number, title: p.title || '', url: p.url || '', files: (p.files || []).map(String) }));\n// A group is covered when an open PR touches its spec file or a page object named in its error.\nconst tokens = (t) => {\n  const set = new Set([base(t.file)]);\n  const first = String(t.error || '').split('\\n')[0];\n  for (const m of first.matchAll(/\\b([A-Z][A-Za-z0-9]+(?:Page|Dialog|Panel|Rail|Service|Client|Store))\\b/g)) set.add(m[1].toLowerCase());\n  return set;\n};\nconst covered = [];\nconst open = [];\nfor (const t of sel.groups || []) {\n  const tk = tokens(t);\n  let hit = null;\n  for (const pr of prList) {\n    const f = pr.files.find(x => x === t.file || x === 'e2e/' + t.file || tk.has(base(x)));\n    if (f) { hit = { number: pr.number, title: pr.title, url: pr.url, file: f }; break; }\n  }\n  if (hit) covered.push({ ...t, coveredBy: hit }); else open.push(t);\n}\nconst max = Number(s.maxTests) > 0 ? Number(s.maxTests) : 1;\nconst selected = open.slice(0, max);\nreturn { selected, covered, skipped: open.length - selected.length, total: sel.total, totalTests: sel.totalTests, prs: prList };"
        }
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
          "schema": {
            "type": "object",
            "properties": {
              "selected": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "project": {
                      "type": "string"
                    },
                    "file": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "testCommand": {
                      "type": "string"
                    },
                    "siblings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "covered": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "project": {
                      "type": "string"
                    },
                    "file": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "testCommand": {
                      "type": "string"
                    },
                    "siblings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "coveredBy": {
                      "type": "object",
                      "properties": {
                        "number": {
                          "type": "number"
                        },
                        "title": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string"
                        },
                        "file": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "skipped": {
                "type": "number"
              },
              "total": {
                "type": "number"
              },
              "totalTests": {
                "type": "number"
              },
              "prs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "number": {
                      "type": "number"
                    },
                    "title": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "files": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      },
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "recentPrs",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Recent open PRs",
        "subLabel": "updated in the last 14 days, max 25",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "fieldType": "string",
          "expression": "// Connector payloads may arrive camelCase or PascalCase; read either.\nconst g = (o, k) => (o == null ? undefined : (o[k] !== undefined ? o[k] : o[k.charAt(0).toUpperCase() + k.slice(1)]));\nconst all = Array.isArray($vars.listOpenPrs1 && $vars.listOpenPrs1.output) ? $vars.listOpenPrs1.output : [];\nconst cutoff = Date.now() - 14 * 24 * 3600 * 1000;\nconst prs = all\n  .map(pr => ({ number: g(pr, 'number'), title: g(pr, 'title') || '', url: g(pr, 'html_url') || g(pr, 'htmlUrl') || '', updatedAt: g(pr, 'updated_at') || g(pr, 'updatedAt') || '' }))\n  .filter(pr => pr.number && (!pr.updatedAt || Date.parse(pr.updatedAt) >= cutoff))\n  .sort((a, b) => String(b.updatedAt).localeCompare(String(a.updatedAt)))\n  .slice(0, 25);\nreturn { prs, totalOpen: all.length };"
        }
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
          "schema": {
            "type": "object",
            "properties": {
              "prs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "number": {
                      "type": "number"
                    },
                    "title": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "updatedAt": {
                      "type": "string"
                    }
                  }
                }
              },
              "totalOpen": {
                "type": "number"
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      },
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "prFileNames",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "File names",
        "subLabel": "drop patches, keep paths",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "fieldType": "string",
          "expression": "const g = (o, k) => (o == null ? undefined : (o[k] !== undefined ? o[k] : o[k.charAt(0).toUpperCase() + k.slice(1)]));\nconst pr = $vars.prFiles.currentItem || {};\nconst files = Array.isArray($vars.listPrFiles1 && $vars.listPrFiles1.output) ? $vars.listPrFiles1.output : [];\nreturn { number: pr.number, title: pr.title, url: pr.url, files: files.map(x => String(g(x, 'filename') || '')).filter(Boolean) };"
        }
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
          "schema": {
            "type": "object",
            "properties": {
              "number": {
                "type": "number"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      },
      "position": {
        "x": 0,
        "y": 0
      },
      "parentId": "prFiles"
    }
  ],
