{
  "$schema": "https://cloud.uipath.com/draft/2024-12/entry-point",
  "$id": "entry-points.json",
  "entryPoints": [
    {
      "filePath": "content/VmAgent.bpmn#start",
      "uniqueId": "9169d066-e626-4372-b2f6-fb1c45863eb4",
      "type": "processorchestration",
      "input": {
        "type": "object",
        "properties": {
          "repoUrl": {
            "type": "string",
            "title": "repoUrl"
          },
          "branch": {
            "type": "string",
            "title": "branch"
          },
          "testCommand": {
            "type": "string",
            "title": "testCommand"
          },
          "maxFixAttempts": {
            "type": "number",
            "title": "maxFixAttempts",
            "default": 3
          },
          "smokeOnly": {
            "type": "boolean",
            "title": "smokeOnly",
            "default": false
          },
          "resumeRunId": {
            "type": "string",
            "title": "resumeRunId",
            "default": ""
          },
          "runnerRepoUrl": {
            "type": "string",
            "title": "runnerRepoUrl",
            "default": "https://github.com/david-rios-uipath/vm-agent-investigator"
          },
          "runnerRef": {
            "type": "string",
            "title": "runnerRef",
            "default": "master"
          }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "hypothesis": {
            "type": "string",
            "title": "hypothesis"
          },
          "evidence": {
            "type": "string",
            "title": "evidence"
          },
          "reproduced": {
            "type": "boolean",
            "title": "reproduced"
          },
          "fixVerified": {
            "type": "boolean",
            "title": "fixVerified"
          },
          "prUrl": {
            "type": "string",
            "title": "prUrl"
          }
        }
      },
      "displayName": "Manual trigger"
    },
    {
      "filePath": "content/ee9f4167-4fc2-4b1b-a1a7-dfb48a9bfff4/agent.json",
      "uniqueId": "ee9f4167-4fc2-4b1b-a1a7-dfb48a9bfff4",
      "type": "agent",
      "targetRuntime": "pythonAgent",
      "input": {
        "type": "object",
        "properties": {
          "start__output__testCommand": {
            "type": "string",
            "description": "Bound from $vars.start.output.testCommand"
          },
          "start__output__repoUrl": {
            "type": "string",
            "description": "Bound from $vars.start.output.repoUrl"
          },
          "start__output__branch": {
            "type": "string",
            "description": "Bound from $vars.start.output.branch"
          },
          "repro__exitCode": {
            "type": "integer",
            "description": "Bound from (($vars.parseStatusRepro.output || {}).exitCode ?? -1)"
          },
          "repro__blobPath": {
            "type": "string",
            "description": "Bound from (($vars.repro.output || {}).OutputBlobPath || '')"
          },
          "fixAttempts": {
            "type": "number",
            "description": "Bound from $vars.fixAttempts"
          },
          "repro__ciHistory": {
            "type": "string",
            "description": "Bound from (($vars.parseStatusRepro.output || {}).ciHistory || '')"
          },
          "repro__excerpt": {
            "type": "string",
            "description": "Bound from (($vars.parseStatusRepro.output || {}).excerpt || '')"
          },
          "investigate__notebook": {
            "type": "string",
            "description": "Bound from (($vars.parseStatusInvestigate.output || {}).notebook || '')"
          },
          "fix__fixSummary": {
            "type": "string",
            "description": "Bound from (($vars.parseStatusFix.output || {}).fixSummary || '')"
          },
          "fix__confidence": {
            "type": "string",
            "description": "Bound from (($vars.parseStatusFix.output || {}).confidence || '')"
          },
          "fix__fixVerified": {
            "type": "boolean",
            "description": "Bound from (($vars.parseStatusFix.output || {}).fixVerified === true)"
          },
          "fix__patch": {
            "type": "string",
            "description": "Bound from (($vars.parseStatusFix.output || {}).patch || '')"
          },
          "pr__prUrl": {
            "type": "string",
            "description": "Bound from (($vars.parseStatusPr.output || {}).prUrl || '')"
          }
        }
      },
      "output": {
        "type": "object",
        "required": [
          "reproduced",
          "hypothesis",
          "evidence"
        ],
        "properties": {
          "reproduced": {
            "type": "boolean"
          },
          "hypothesis": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        }
      },
      "displayName": "Investigation Summarizer",
      "hiddenAtDesignTime": true
    }
  ]
}
