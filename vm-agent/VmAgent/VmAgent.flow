  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger",
        "icon": "play"
      },
      "inputs": {
        "entryPointId": "9169d066-e626-4372-b2f6-fb1c45863eb4",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the process.",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "id": "setupVm",
      "type": "uipath.core.rpa-workflow.ca36341d-ecec-4ba6-aa76-134d0afe4ba7",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Set up VM (clone + install)",
        "icon": "rpa"
      },
      "inputs": {
        "Script": "=js:`$ErrorActionPreference = 'Stop'\n$repo = 'C:\\\\vm-agent\\\\repo'\n$bin  = 'C:\\\\vm-agent\\\\bin'\n$branch = '${$vars.start.output.branch}'\n$url = '${$vars.start.output.repoUrl}'\nif ($env:GIT_TOKEN) { $url = $url -replace '^https://', \"https://x-access-token:$($env:GIT_TOKEN)@\" }\nNew-Item -ItemType Directory -Force -Path 'C:\\\\vm-agent' | Out-Null\nNew-Item -ItemType Directory -Force -Path $bin | Out-Null\n$env:PATH = \"$bin;$env:PATH\"\nif (Test-Path \"$repo\\\\.git\") {\n  Write-Output \"[setup] reusing clone at $repo\"\n  git -C $repo fetch --depth 1 origin $branch\n  git -C $repo reset --hard FETCH_HEAD\n} else {\n  Write-Output \"[setup] cloning $branch\"\n  git clone --depth 1 --branch $branch $url $repo\n}\nSet-Location $repo\ncorepack enable --install-directory $bin pnpm\nif (Test-Path \"$bin\\\\pnpm.cmd\") { Write-Output \"[setup] pnpm shim at $bin\\\\pnpm.cmd\" } else { Write-Output \"[setup] WARNING: no pnpm shim in $bin\" }\ncmd.exe /c \"set PATH=$bin;%PATH% && corepack pnpm install --frozen-lockfile\"\ncmd.exe /c \"set PATH=$bin;%PATH% && corepack pnpm exec playwright install chromium\"\nWrite-Output \"[setup] head: $(git -C $repo rev-parse --short HEAD)\"\nWrite-Output \"[setup] pnpm: $(cmd.exe /c \"set PATH=$bin;%PATH% && pnpm --version\")\"\nWrite-Output \"[setup] done\"\n`",
        "WorkDir": "C:\\vm-agent",
        "RunId": "=js:$vars.start.output.runId + '/setup'",
        "TimeoutMinutes": 30
      },
      "outputs": {
        "output": {
          "type": "object",
          "source": "=this",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the RPA process fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "runTest",
      "type": "uipath.core.rpa-workflow.ca36341d-ecec-4ba6-aa76-134d0afe4ba7",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Run failing test",
        "icon": "rpa"
      },
      "inputs": {
        "Script": "=js:`$ErrorActionPreference = 'Continue'\n$repo = 'C:\\\\vm-agent\\\\repo'\n$bin  = 'C:\\\\vm-agent\\\\bin'\nSet-Location $repo\n$cmd = '${$vars.start.output.testCommand}'\nWrite-Output \"[test] $cmd\"\ncmd.exe /c \"set PATH=$bin;%PATH% && $cmd\"\nexit $LASTEXITCODE\n`",
        "WorkDir": "C:\\vm-agent",
        "RunId": "=js:$vars.start.output.runId + '/test'",
        "TimeoutMinutes": 45
      },
      "outputs": {
        "output": {
          "type": "object",
          "source": "=this",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the RPA process fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "vmExecTool",
      "type": "uipath.agent.resource.tool.process.ca36341d-ecec-4ba6-aa76-134d0afe4ba7",
      "typeVersion": "1.0.0",
      "display": {
        "label": "vm-exec",
        "icon": "rpa"
      },
      "inputs": {
        "source": "29664e8a-bd00-4e62-889b-cc98493010d4"
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End",
        "icon": "circle-check"
      },
      "inputs": {},
      "outputs": {
        "reproduced": {
          "type": "boolean",
          "source": "=js:$vars.autonomousAgent1.output.reproduced"
        },
        "hypothesis": {
          "type": "string",
          "source": "=js:$vars.autonomousAgent1.output.hypothesis"
        },
        "evidence": {
          "type": "string",
          "source": "=js:$vars.autonomousAgent1.output.evidence"
        }
      }
    },
    {
      "id": "autonomousAgent1",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.4",
      "display": {
        "label": "e2e",
        "shape": "rectangle",
        "icon": "autonomous-agent",
        "subLabel": ""
      },
      "inputs": {
        "agentInputVariables": [
