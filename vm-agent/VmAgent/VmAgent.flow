    {
      "id": "openPrInstructions",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Open PR instructions",
        "subLabel": "",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "expression": "return `$ErrorActionPreference = 'Continue'\n$repo = 'C:\\\\vm-agent\\\\repo'\n$bin  = 'C:\\\\vm-agent\\\\bin'\n$runId = '${$vars.deriveRunId.output}'\n$patch = \"C:\\\\vm-agent\\\\notes\\\\$runId\\\\fix.patch\"\n$repoUrl = '${$vars.start.output.repoUrl}'\n$base = '${$vars.start.output.branch}'\n$cmd = '${$vars.start.output.testCommand}'\nif (-not $env:GH_TOKEN) { Write-Output 'PR_URL='; Write-Output '[pr] GH_TOKEN not set; skipping'; exit 0 }\nif (-not (Test-Path $patch)) { Write-Output 'PR_URL='; Write-Output '[pr] no fix.patch; skipping'; exit 0 }\n$env:PATH = \"$bin;$env:PATH\"\nif (-not (Test-Path \"$bin\\\\gh.exe\")) {\n  Write-Output '[pr] installing gh into bin'\n  try {\n    $rel = Invoke-RestMethod https://api.github.com/repos/cli/cli/releases/latest -Headers @{ 'User-Agent' = 'vm-agent' }\n    $asset = ($rel.assets | Where-Object name -like '*_windows_amd64.zip').browser_download_url\n    Invoke-WebRequest $asset -OutFile \"$env:TEMP\\\\gh.zip\" -UseBasicParsing\n    Expand-Archive \"$env:TEMP\\\\gh.zip\" -DestinationPath \"$env:TEMP\\\\gh\" -Force\n    Copy-Item (Get-ChildItem \"$env:TEMP\\\\gh\" -Recurse -Filter gh.exe | Select-Object -First 1).FullName $bin\n  } catch { Write-Output 'PR_URL='; Write-Output \"[pr] gh install failed: $_\"; exit 0 }\n}\n$ownerRepo = (($repoUrl -replace '^https://github.com/', '') -replace '\\\\.git$', '').Trim('/')\n$spec = if ($cmd -match '([\\\\w.-]+?)(?:\\\\.spec)?\\\\.ts\\\\b') { $Matches[1] } else { 'e2e' }\n$branch = \"e2e-investigator/$runId\"\n$title = \"test(e2e): fix $spec (automated investigator)\"\n$tokenRe = [regex]::Escape($env:GH_TOKEN)\nfunction Reset-Tree { git checkout -- . 2>$null; git checkout --detach FETCH_HEAD 2>$null; git branch -D $branch 2>$null | Out-Null }\nSet-Location $repo\ngit checkout -- .\ngit checkout -B $branch HEAD 2>&1 | ForEach-Object { \"$_\" }\ngit apply $patch 2>&1 | ForEach-Object { \"$_\" }\nif ($LASTEXITCODE -ne 0) { Write-Output 'PR_URL='; Write-Output '[pr] git apply failed'; Reset-Tree; exit 0 }\ngit -c user.name='e2e-investigator' -c user.email='e2e-investigator@uipath.com' commit -am $title 2>&1 | Select-Object -First 1\nif ($LASTEXITCODE -ne 0) { Write-Output 'PR_URL='; Write-Output '[pr] git commit failed'; Reset-Tree; exit 0 }\n$pushUrl = \"https://x-access-token:$($env:GH_TOKEN)@github.com/$ownerRepo.git\"\ngit push -f $pushUrl $branch 2>&1 | ForEach-Object { \"$_\" -replace $tokenRe, '***' }\nif ($LASTEXITCODE -ne 0) { Write-Output 'PR_URL='; Write-Output '[pr] git push failed'; Reset-Tree; exit 0 }\n$bodyFile = \"C:\\\\vm-agent\\\\notes\\\\$runId\\\\pr-body.md\"\n$body = @'\nAutomated fix from the e2e investigator flow.\n\nRun: ${$vars.deriveRunId.output}\n\n## Fix summary\n${$vars.fixer.output.fixSummary}\n\n## Verification\nSpec re-run with --retries=0 passed after applying this patch (see flow run ${$vars.deriveRunId.output}).\n\nNotebook and full logs: bucket e2e-investigations/${$vars.deriveRunId.output}/\n'@\nSet-Content -Path $bodyFile -Value $body\n$env:GH_PROMPT_DISABLED = '1'\n$out = @(gh pr create --draft --repo $ownerRepo --base $base --head $branch --title $title --body-file $bodyFile 2>&1 | ForEach-Object { \"$_\" -replace $tokenRe, '***' })\n$out | ForEach-Object { Write-Output $_ }\n$url = $out | Where-Object { $_ -like 'https://*' } | Select-Object -Last 1\nif ($url) { Write-Output \"PR_URL=$url\" } else { Write-Output 'PR_URL='; Write-Output '[pr] gh pr create did not return a URL' }\nReset-Tree\n`",
          "fieldType": "string"
        }
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
