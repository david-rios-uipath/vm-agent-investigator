    {
      "id": "vmExecTool",
      "type": "uipath.agent.resource.tool.process.ca36341d-ecec-4ba6-aa76-134d0afe4ba7",
      "typeVersion": "1.0.0",
      "display": {
        "label": "vm-exec",
        "icon": "rpa"
      },
      "inputs": {
        "source": "29664e8a-bd00-4e62-889b-cc98493010d4",
        "id": "vmExecTool",
        "name": "vm_exec",
        "description": "Run a PowerShell script on the Windows robot VM and get its output. The VM is a persistent Windows Server with git, node, and corepack/pnpm on PATH. Use it to clone a repo, install dependencies, run a Playwright spec, and inspect files or logs. Returns the exit code, the last 32000 chars of merged stdout+stderr, and the bucket path of the complete log.",
        "guardrails": [],
        "isEnabled": true,
        "referenceKey": "ca36341d-ecec-4ba6-aa76-134d0afe4ba7",
        "inputSchema": {
          "type": "object",
          "properties": {
            "Script": {
              "type": "string",
              "description": "PowerShell script to run on the VM. Multiple lines allowed. Runs with powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass."
            },
            "WorkDir": {
              "type": "string",
              "description": "Working directory on the VM. Always pass the same value across calls so a clone survives between calls. Default is %TEMP%\\vm-agent."
            },
            "RunId": {
              "type": "string",
              "description": "Log grouping prefix in the storage bucket. Pass the runId given to you."
            },
            "TimeoutMinutes": {
              "type": "number",
              "description": "Kill the script after this many minutes. Exit code 124 means it timed out."
            },
            "guardrails": {
              "type": "array"
            }
          },
          "required": [
            "Script"
          ]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "ExitCode": {
              "type": "integer",
              "description": "0 = success, 124 = timeout, -1 = runner exception"
            },
            "Stdout": {
              "type": "string",
              "description": "Merged stdout+stderr, tail-truncated to 32000 chars"
            },
            "OutputBlobPath": {
              "type": "string",
              "description": "Path of the complete log inside the e2e-investigations bucket"
            }
          }
        },
        "properties": {
          "folderPath": "e2e-investigator",
          "processName": "vm-exec-vm",
          "exampleCalls": []
        },
        "argumentProperties": {},
        "settings": {},
        "folderPath": "e2e-investigator",
        "Script": {
          "mode": "prompt",
          "textValue": "",
          "promptValue": "PowerShell script to run on the VM. Multiple lines allowed. Runs with powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass.",
          "argumentPath": ""
        },
        "WorkDir": {
          "mode": "prompt",
          "textValue": "",
          "promptValue": "Working directory on the VM. Always pass the same value across calls so a clone survives between calls. Default is %TEMP%\\vm-agent.",
          "argumentPath": ""
        },
        "RunId": {
          "mode": "prompt",
          "textValue": "",
          "promptValue": "Log grouping prefix in the storage bucket. Pass the runId given to you.",
          "argumentPath": ""
        },
        "TimeoutMinutes": {
          "mode": "prompt",
          "textValue": "",
          "promptValue": "Kill the script after this many minutes. Exit code 124 means it timed out.",
          "argumentPath": ""
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End",
        "subLabel": "",
        "icon": "circle-check"
      },
      "inputs": {},
      "outputs": {
        "hypothesis": {
          "source": {
            "type": "jsExpression",
            "expression": "$vars.investigationSummarizer.output.hypothesis",
            "fieldType": "string"
          },
          "type": "string"
        },
        "evidence": {
          "source": {
            "type": "jsExpression",
            "expression": "$vars.investigationSummarizer.output.evidence",
            "fieldType": "string"
          },
          "type": "string"
        },
        "reproduced": {
          "source": {
            "type": "jsExpression",
            "expression": "$vars.investigationSummarizer.output.reproduced",
            "fieldType": "boolean"
          },
          "type": "string"
        }
      }
    },
    {
      "id": "investigator",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.4",
      "display": {
        "label": "Investigator",
        "subLabel": "",
        "shape": "rectangle",
        "icon": "autonomous-agent"
      },
      "inputs": {
        "systemPrompt": "You investigate failing end-to-end tests by running PowerShell on a Windows robot VM through the\n  vm_exec tool. The repository is already cloned at C:\\vm-agent\\repo. The run context, tools, and\n  procedure for this pass are in the user message.\n\n  Invariants, every pass:\n  - The notebook on the VM is the deliverable. Your output fields only control whether the loop\n    runs again; anything not written to the notebook is lost.\n  - Every vm_exec call passes WorkDir=\"C:\\vm-agent\" and the RunId from the run context.\n  - Reads only. Never run interactive commands, install global packages, or modify remote state\n    (no git push, publish, branch deletion; no POST/PATCH/DELETE to GitHub).\n  - Prefer evidence over theory: run the script that could falsify a claim, quote error lines\n    verbatim with file:line, and record environment failures (missing tool, auth, network) in the\n    notebook instead of working around them silently.\n  - If any value in the run context is blank, do not invent one. Record it in the notebook,\n    return investigationComplete=false, and name the missing field in rationale.",
        "userPrompt": "   Current pass: {{ $vars.iteration }}\n\n    Run context:\n    - repository: {{ $vars.start.output.repoUrl }} @ {{ $vars.start.output.branch }}\n    - test command: {{ $vars.start.output.testCommand }}\n    - runId: {{ $vars.start.output.runId }}\n    - test exit code: {{ $vars.runTest.output.ExitCode }}\n    - full log bucket path: {{ $vars.runTest.output.OutputBlobPath }}\n    - test output tail:\n    {{ $vars.runTest.output.Stdout }}\n\n    The repository has ALREADY been cloned and its dependencies installed at C:\\vm-agent\\repo on that VM,\n    and the failing test command has ALREADY been run once — its exit code, output tail, and full-log\n    bucket path are in the run context above. Your job is to explain WHY it failed, and to write that\n    explanation into a notebook file on the VM.\n\n    THE NOTEBOOK IS THE DELIVERABLE.\n\n    Your report is not returned through your output fields. It is the file\n    C:\\vm-agent\\notes\\{{ $vars.start.output.runId }}\\NOTES.md on the VM. A later step reads that file and\n    writes the final report; anything not in it is lost. Your output fields only control whether the loop\n    runs again.\n\n    You have two tools.\n\n    vm_exec runs a PowerShell script on the same VM and returns its exit code, output tail, and the\n    bucket path of the full log. Always pass WorkDir=\"C:\\vm-agent\" so you operate on the existing clone,\n    and pass RunId=\"{{ $vars.start.output.runId }}\".\n\n    GitHub HTTP Request reaches the repository's history on github.com — CI runs, pull requests, issues.\n    Use it for what the VM does not have, never for source code; the clone is local and faster. At most\n    2 calls for the whole run. If a call errors, record the error in the notebook and do not retry it.\n\n    How to work:\n    1. Read the exit code and output tail in the run context first. Do not re-run the full suite to see\n    what you were already told.\n    2. If C:\\vm-agent\\notes\\{{ $vars.start.output.runId }}\\NOTES.md already exists, read it first. It is\n    your own record from an earlier pass. Continue from it; do not repeat work it already contains.\n    3. Early — ideally on pass 1, before you build any theory — ask GitHub whether this is new:\n\n         GET /repos/<owner>/<repo>/actions/runs?branch={{ $vars.start.output.branch }}&per_page=20\n\n       Derive <owner>/<repo> from the repository URL in the run context. Whether this spec was already\n       failing on this branch before today decides whether you are looking at a regression, a\n       long-standing flake, or an environment fault. Knowing that first stops you spending vm_exec calls\n       on the wrong question. Record the answer in the notebook.\n\n    4. Work one leg at a time. A leg is a single causal claim — \"the undo count never advances\n       because the editor never fires the change event\", \"the prompt edit is written to a stale\n       store instance\". Stay on a leg until it is settled.\n\n       Each step of a leg:\n       a. State the claim you are testing.\n       b. Run the script that could FALSIFY it — print the value, read the artifact, check\n          the handler. Not a script that merely looks nearby.\n       c. Record the verdict in the notebook: confirmed, refuted, or still open and why.\n       d. If the result narrows the SAME claim, keep going. That is the same leg, and there\n          is no reason to stop.\n\n       Going deeper is not a new leg. Symptom, then the assertion that produced it, then the\n       value the assertion read, then where that value is set — that is one leg, followed\n       properly. You may take as many steps as it needs.\n\n    5. Hand off when the leg is settled and the next claim is a different question. Not before.\n       A refuted leg is a completed leg: record what it ruled out, then hand off with the next\n       claim in nextFocus. Do not hand off mid-leg with an unverified guess — verify it or\n       record it as refuted first.\n\n    6. Playwright artifacts are usually the fastest way to settle a leg about a UI assertion.\n       error-context.md and trace.zip under C:\\vm-agent\\repo\\e2e\\test-results\\... hold the DOM\n       and step trace at the moment of failure. Read them before theorizing about source.\n       trace.zip is a zip of JSON — Expand-Archive it and read trace.trace for the step timeline.\n    7. The clone carries 50 commits of history. `git log`, `git show` and `git blame` work locally and\n       are the right way to find what changed in the failing area. If a git history command returns\n       suspiciously little — one commit for a file many people touch — say so in the notebook rather\n       than treating that single commit as the suspect.\n\n    8. Ceiling: 10 vm_exec calls per pass, with the last reserved for the notebook write. This\n       is a safety limit, not a target. Reaching it means the leg was too broad — say so in\n       rationale. Stopping well under it with a leg still open is the more common failure.\n\n    Searching the repo: use `rg` (ripgrep), which skips node_modules by default:\n\n        rg -n \"someSymbol\" --type ts\n\n    Never use `Get-ChildItem -Recurse` to search the tree. It walks into every node_modules in the\n    monorepo and will run for minutes or hang outright.\n\n    Before you return, write the notebook. This is mandatory and is your final vm_exec call:\n\n      $dir = \"C:\\vm-agent\\notes\\{{ $vars.start.output.runId }}\"\n      New-Item -ItemType Directory -Force -Path $dir | Out-Null\n      $body = @'\n      ## Pass {{ $vars.iteration }}\n      Hypothesis: <one sentence, or \"no cause established\">\n      Decisive error lines: <quoted verbatim, with file:line>\n      Evidence: <what you ran and what it showed>\n      Artifacts read: <error-context.md / trace.zip paths, or \"none\">\n      Artifacts read: <error-context.md / trace.zip paths, or \"none\">\n      CI history: <what the GitHub Actions runs showed, or \"not checked\">\n      Bucket logs: <every OutputBlobPath you used, including the one you were given>\n      Unchecked: <what a next pass should look at>\n      '@\n      Add-Content -Path \"$dir\\NOTES.md\" -Value $body\n\n    Append; never overwrite. Later passes add sections, they do not replace earlier ones. Quote error\n    lines verbatim rather than paraphrasing them. Write the notebook even when you found nothing — \"no\n    cause established, here is what I ruled out\" is a usable result; a missing file is not.\n\n    Rules:\n    - Every call must pass RunId=\"{{ $vars.start.output.runId }}\" and WorkDir=\"C:\\vm-agent\".\n    - Never run interactive commands, never install global packages, never modify remote state (no git\n    push, no publish, no deleting branches). GitHub calls are reads only — never POST, PATCH or DELETE.\n    - If the clone is unexpectedly missing (a different VM served your call), re-create it:\n    `git clone --depth 50 --branch {{ $vars.start.output.branch }} {{ $vars.start.output.repoUrl }} C:\\vm-agent\\repo`,\n    then continue.\n    - pnpm exists only through corepack. Use `corepack pnpm`, and run `corepack enable pnpm` first if a\n    subprocess needs a bare `pnpm` on PATH (Playwright's config.webServer does). A failure that is only\n    \"'pnpm' is not recognized\" is a VM environment artifact, not the CI failure you were asked to explain\n    — say so in the notebook.\n    - If a call fails for an environment reason (missing tool, auth failure, network error), record it in\n    the notebook rather than working around it silently.\n    - If any value in the run context is blank, do not invent one. Record the blank field in the\n    notebook, set investigationComplete false, and name the missing field in rationale.\n\n    Then return your output fields:\n\n    - investigationComplete: true only if the notebook now names a cause, or you have exhausted your\n    vm_exec budget, or GitHub showed this failure predates the change under investigation and is already\n    tracked. Do not set it true merely because you ran out of ideas on the first pass — that is what\n    nextFocus is for.\n    - nextFocus: when investigationComplete is false, the single specific thing the next pass should do.\n    Empty when complete.\n    - rationale: why you set investigationComplete the way you did. Name the evidence that closed the\n    question, or the specific gap that keeps it open.",
        "model": "anthropic.claude-sonnet-5",
        "mode": "standard",
        "temperature": 0.05,
        "maxTokenPerResponse": 16384,
        "maxIterations": 100,
        "isConversational": false,
        "guardrails": [],
        "name": "e2e",
        "agentInputVariables": [
          {
            "id": "start__output__repoUrl",
            "type": "string",
            "binding": "=$vars.start.output.repoUrl"
          },
          {
            "id": "start__output__branch",
            "type": "string",
            "binding": "=$vars.start.output.branch"
          },
          {
            "id": "start__output__testCommand",
            "type": "string",
            "binding": "=$vars.start.output.testCommand"
          },
          {
            "id": "start__output__runId",
            "type": "string",
            "binding": "=$vars.start.output.runId"
          },
          {
            "id": "runTest__output__ExitCode",
            "type": "integer",
            "binding": "=$vars.runTest.output.ExitCode"
          },
          {
            "id": "runTest__output__Stdout",
            "type": "string",
            "binding": "=$vars.runTest.output.Stdout"
          },
          {
            "id": "runTest__output__OutputBlobPath",
            "type": "string",
            "binding": "=$vars.runTest.output.OutputBlobPath"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "investigationComplete",
            "type": "boolean",
            "required": true
          },
          {
            "id": "nextFocus",
            "type": "string",
            "description": "What the next pass should focus on. Empty when investigation complete.",
            "required": true
          },
          {
            "id": "rationale",
            "type": "string",
            "description": "Why was the investigation marked as complete/not complete?",
            "required": true
          }
        ],
        "source": "e41af830-1e4b-4d6b-a7e0-5595f152ea88",
        "modelMaxTokens": 128000
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "setupInstructions",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Setup instructions",
        "subLabel": "",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "expression": "return `$ErrorActionPreference = 'Stop'\n  $repo = 'C:\\\\vm-agent\\\\repo'\n  $bin  = 'C:\\\\vm-agent\\\\bin'\n  $branch = '${$vars.start.output.branch}'\n  $url = '${$vars.start.output.repoUrl}'\n  if ($env:GIT_TOKEN) { $url = $url -replace '^https://', \"https://x-access-token:$($env:GIT_TOKEN)@\" }\n  New-Item -ItemType Directory -Force -Path 'C:\\\\vm-agent' | Out-Null\n  New-Item -ItemType Directory -Force -Path $bin | Out-Null\n  $env:PATH = \"$bin;$env:PATH\"\n  if (Test-Path \"$repo\\\\.git\") {\n    Write-Output \"[setup] reusing clone at $repo\"\n    git -C $repo fetch --depth 50 origin $branch\n    if ($LASTEXITCODE -ne 0) { throw \"[setup] git fetch failed with $LASTEXITCODE\" }\n    git -C $repo reset --hard FETCH_HEAD\n    if ($LASTEXITCODE -ne 0) { throw \"[setup] git reset failed with $LASTEXITCODE\" }\n  } else {\n    Write-Output \"[setup] cloning $branch\"\n    git clone --depth 50 --branch $branch $url $repo\n    if ($LASTEXITCODE -ne 0) { throw \"[setup] git clone failed with $LASTEXITCODE\" }\n  }\n  Set-Location $repo\n  corepack enable --install-directory $bin pnpm\n  if (Test-Path \"$bin\\\\pnpm.cmd\") { Write-Output \"[setup] pnpm shim at $bin\\\\pnpm.cmd\" } else { Write-Output \"[setup] WARNING: no pnpm shim in $bin\" }\n  cmd.exe /c \"set PATH=$bin;%PATH% && corepack pnpm install --frozen-lockfile\"\n  if ($LASTEXITCODE -ne 0) { throw \"[setup] pnpm install failed with $LASTEXITCODE\" }\n  cmd.exe /c \"set PATH=$bin;%PATH% && corepack pnpm exec playwright install chromium\"\n  if ($LASTEXITCODE -ne 0) { throw \"[setup] playwright install failed with $LASTEXITCODE\" }\n  Write-Output \"[setup] head: $(git -C $repo rev-parse --short HEAD)\"\n  $pnpmVer = cmd.exe /c \"set PATH=$bin;%PATH% && pnpm --version\"\n  Write-Output \"[setup] pnpm: $pnpmVer\"\n  Write-Output \"[setup] done\"\n`",
          "fieldType": "string"
        }
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "testRunInstructions",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Test run instructions",
        "subLabel": "",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "expression": "return `$ErrorActionPreference = 'Continue'\n  $repo = 'C:\\\\vm-agent\\\\repo'\n  $bin  = 'C:\\\\vm-agent\\\\bin'\n  Set-Location $repo\n  $cmd = '${$vars.start.output.testCommand}'\n  Write-Output \"[test] $cmd\"\n  cmd.exe /c \"set PATH=$bin;%PATH% && set CI=true && $cmd\"\n  $exit = $LASTEXITCODE\n\n  $stamp = Get-Date -UFormat \"%Y%m%d-%H%M%S\"\n  $art = \"C:\\\\vm-agent\\\\artifacts\\\\$stamp\"\n  New-Item -ItemType Directory -Force -Path $art | Out-Null\n  if (Test-Path \"$repo\\\\e2e\\\\test-results\") {\n    Compress-Archive -Path \"$repo\\\\e2e\\\\test-results\\\\*\" -DestinationPath \"$art\\\\test-results.zip\" -Force\n  }\n  if (Test-Path \"$repo\\\\e2e\\\\playwright-report\") {\n    Compress-Archive -Path \"$repo\\\\e2e\\\\playwright-report\\\\*\" -DestinationPath \"$art\\\\playwright-report.zip\" -Force\n  }\n  Write-Output \"[artifacts] $art\"\n  Get-ChildItem -Path \"$repo\\\\e2e\\\\test-results\" -Recurse -File -ErrorAction SilentlyContinue |\n    Where-Object { $_.Name -eq 'error-context.md' -or $_.Name -eq 'trace.zip' } |\n    ForEach-Object { Write-Output \"[artifact] $($_.FullName)\" }\n\n  exit $exit\n  `",
          "fieldType": "string"
        }
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "decision1",
      "type": "core.logic.decision",
      "typeVersion": "1.3",
      "display": {
        "label": "Decision",
        "subLabel": "",
        "icon": "trending-up-down"
      },
      "inputs": {
        "trueLabel": "True",
        "falseLabel": "False",
        "expression": {
          "type": "jsExpression",
          "expression": "$vars.iteration > $vars.start.output.maxIterations || $vars.investigator.output.investigationComplete",
          "fieldType": "boolean"
        }
      }
    },
    {
      "id": "investigationSummarizer",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.4",
      "display": {
        "label": "Investigation Summarizer",
        "subLabel": "",
        "shape": "rectangle",
        "icon": "autonomous-agent"
      },
      "inputs": {
        "systemPrompt": "You write the final report for an automated e2e test investigation. You have no tools.\nYou are given: the failing test command, the test run's exit code and output tail, the bucket path of the full log, and the investigator's notebook (its own record across passes).\n\nBase every claim on the notebook and the test output. Never invent a cause that the notebook does not support.\n\nSet classification to:\n  - regression: the notebook identifies a code change that breaks the test\n  - flake: timing/ordering dependent, passes on retry, no code cause\n  - infrastructure: the VM, licensing, environment or tooling caused it, not the product\n  - known-platform-issue: a known Studio Web / Orchestrator / solution failure\n  - inconclusive: the notebook does not establish a cause\n\nIf the notebook is missing or empty, set classification to inconclusive, explain that inunverified, and report what the raw test output alone shows.\n\nQuote decisive error lines in evidence, with file:line where the notebook has them, and list the bucket log paths. State plainly in unverified what remains unchecked. An honest gap is more useful than a confident guess.",
        "userPrompt": "Test command: {{ $vars.start.output.testCommand }}\nRepository: {{ $vars.start.output.repoUrl }} @ {{ $vars.start.output.branch }}\nTest exit code: {{ $vars.runTest.output.ExitCode }}\nFull test log in bucket: {{ $vars.runTest.output.OutputBlobPath }}\nInvestigation passes used: {{ $vars.iteration }} of {{ $vars.start.output.maxIterations }}\n\nTest run output tail: {{ $vars.runTest.output.Stdout }}\n\nInvestigator notebook: {{ $vars.readNotes.output.Stdout }}\n\nWrite the final report. Base every claim on the notebook and the test output above, and fill every field of the output schema.",
        "model": "anthropic.claude-opus-4-8",
        "mode": "standard",
        "agentInputVariables": [],
        "agentOutputVariables": [
          {
            "id": "reproduced",
            "type": "boolean",
            "required": true
          },
          {
            "id": "hypothesis",
            "type": "string",
            "required": true
          },
          {
            "id": "evidence",
            "type": "string",
            "required": true
          }
        ],
        "source": "ee9f4167-4fc2-4b1b-a1a7-dfb48a9bfff4",
        "temperature": 0,
        "maxTokenPerResponse": 16384,
        "maxIterations": 25,
        "modelMaxTokens": 128000
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
