{
  "id": "31b0a5d8-7787-4c4d-84ca-a78490eb8e70",
  "version": "1.9",
  "name": "VmAgent",
  "runtime": "maestro",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger",
        "icon": "play"
      },
      "inputs": {
        "entryPointId": "9169d066-e626-4372-b2f6-fb1c45863eb4",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the process.",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "id": "investigator",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.4",
      "display": {
        "label": "E2E investigator",
        "icon": "autonomous-agent"
      },
      "inputs": {
        "systemPrompt": "You investigate failing end-to-end tests by running commands on a Windows robot VM.\n\nYou have one tool, vm_exec, which runs a PowerShell script on that VM and returns its exit code, output tail, and the bucket path of the full log. The VM is a real Windows Server: git, node and corepack (for pnpm) are on PATH, and it runs as the LocalService account.\n\nHow to work:\n1. First call: clone the repo and install dependencies in one script. Always pass WorkDir=\"C:\\\\vm-agent\\\\repo\" so later calls reuse the clone. Use `corepack pnpm` and never plain `pnpm` or `npm -g`, because user-scoped installs are invisible to this account. Set TimeoutMinutes=25 for install steps.\n2. Then run the given test command and read the failure output.\n3. Then run at most three more focused scripts to narrow the cause: re-run a single spec, print the relevant source file, check a config value, or check git log for recent changes to the failing area.\n\nRules:\n- Call vm_exec at most 6 times in total. After the sixth call, stop running commands and decide with the evidence you already have.\n- Every call must pass the runId you were given as RunId, and the same WorkDir.\n- Never run interactive commands, never install global packages, never modify remote state (no git push, no publish, no deleting branches).\n- A clone plus install takes several minutes. Do not retry a call that timed out with the same timeout; raise TimeoutMinutes or split the script instead.\n- If a call fails for an environment reason (missing tool, auth failure, network error), say so in evidence rather than working around it silently.\n\nFinish by returning every field of the output schema: reproduced, hypothesis, and evidence. Quote the decisive error lines in evidence and list every OutputBlobPath you received. If you could not reproduce the failure, set reproduced to false and explain in hypothesis what the VM did instead. Never end a run without a determination.\n\nKnown VM environment facts (from earlier runs on this pool):\n- pnpm is installed only through corepack, so a subprocess that shells out to a bare `pnpm` fails with \"'pnpm' is not recognized as an internal or external command\". Playwright's config.webServer does exactly that. Before running tests, run `corepack enable pnpm` once in the same script so a real pnpm shim exists on PATH for spawned subprocesses.\n- If a run still fails only because a spawned process could not find pnpm, that is a VM environment artifact, not the CI failure you were asked to reproduce. Say so explicitly in evidence, set reproduced to false, and do not present it as the root cause.",
        "userPrompt": "Repository: {{ $vars.start.output.repoUrl }}\nBranch: {{ $vars.start.output.branch }}\nTest command that fails in CI: {{ $vars.start.output.testCommand }}\nrunId for logs: {{ $vars.start.output.runId }}\n\nReproduce this failure on the VM and tell me the root cause.",
        "model": "anthropic.claude-sonnet-5",
        "mode": "standard",
        "temperature": 0,
        "maxTokenPerResponse": 128000,
        "maxIterations": 25,
        "isConversational": false,
        "guardrails": [],
        "name": "E2E investigator",
        "agentInputVariables": [
          {
            "id": "start__output__repoUrl",
            "type": "string",
            "binding": "=$vars.start.output.repoUrl",
            "description": "Bound from $vars.start.output.repoUrl"
          },
          {
            "id": "start__output__branch",
            "type": "string",
            "binding": "=$vars.start.output.branch",
            "description": "Bound from $vars.start.output.branch"
          },
          {
            "id": "start__output__testCommand",
            "type": "string",
            "binding": "=$vars.start.output.testCommand",
            "description": "Bound from $vars.start.output.testCommand"
          },
          {
            "id": "start__output__runId",
            "type": "string",
            "binding": "=$vars.start.output.runId",
            "description": "Bound from $vars.start.output.runId"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "reproduced",
            "type": "boolean"
          },
          {
            "id": "hypothesis",
            "type": "string"
          },
          {
            "id": "evidence",
            "type": "string"
          }
        ],
        "source": "d2da9233-9138-4805-95de-3c2759cfa45f"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "vmExecTool",
      "type": "uipath.agent.resource.tool.process.e9708dfd-323a-4f58-a54d-4518cf96387e",
      "typeVersion": "1.0.0",
      "display": {
        "label": "vm-exec",
        "icon": "rpa"
      },
      "inputs": {
        "source": "29664e8a-bd00-4e62-889b-cc98493010d4",
        "id": "vmExecTool",
        "name": "vm_exec",
        "description": "Run a PowerShell script on the Windows robot VM and get its output. The VM is a persistent Windows Server with git, node, and corepack/pnpm on PATH. Use it to clone a repo, install dependencies, run a Playwright spec, and inspect files or logs. Returns the exit code, the last 32000 chars of merged stdout+stderr, and the bucket path of the complete log.",
        "guardrails": [],
        "isEnabled": true,
        "referenceKey": "e9708dfd-323a-4f58-a54d-4518cf96387e",
        "inputSchema": {
          "type": "object",
          "properties": {
            "Script": {
              "type": "string",
              "description": "PowerShell script to run on the VM. Multiple lines allowed. Runs with powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass."
            },
            "WorkDir": {
              "type": "string",
              "description": "Working directory on the VM. Always pass the same value across calls so a clone survives between calls. Default is %TEMP%\\vm-agent."
            },
            "RunId": {
              "type": "string",
              "description": "Log grouping prefix in the storage bucket. Pass the runId given to you."
            },
            "TimeoutMinutes": {
              "type": "integer",
              "description": "Kill the script after this many minutes. Exit code 124 means it timed out."
            },
            "guardrails": {
              "type": "array"
            }
          },
          "required": [
            "Script"
          ]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "ExitCode": {
              "type": "integer",
              "description": "0 = success, 124 = timeout, -1 = runner exception"
            },
            "Stdout": {
              "type": "string",
              "description": "Merged stdout+stderr, tail-truncated to 32000 chars"
            },
            "OutputBlobPath": {
              "type": "string",
              "description": "Path of the complete log inside the e2e-investigations bucket"
            }
          }
        },
        "properties": {
          "folderPath": "e2e-investigator",
          "processName": "vm-exec",
          "exampleCalls": []
        },
        "argumentProperties": {},
        "settings": {},
        "folderPath": "e2e-investigator",
        "Script": {
          "mode": "prompt",
          "textValue": "",
          "promptValue": "PowerShell script to run on the VM. Multiple lines allowed. Runs with powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass.",
          "argumentPath": ""
        },
        "WorkDir": {
          "mode": "prompt",
          "textValue": "",
          "promptValue": "Working directory on the VM. Always pass the same value across calls so a clone survives between calls. Default is %TEMP%\\vm-agent.",
          "argumentPath": ""
        },
        "RunId": {
          "mode": "prompt",
          "textValue": "",
          "promptValue": "Log grouping prefix in the storage bucket. Pass the runId given to you.",
          "argumentPath": ""
        },
        "TimeoutMinutes": {
          "mode": "prompt",
          "textValue": "",
          "promptValue": "Kill the script after this many minutes. Exit code 124 means it timed out.",
          "argumentPath": ""
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End",
        "icon": "circle-check"
      },
      "inputs": {},
      "outputs": {
        "reproduced": {
          "type": "boolean",
          "source": "=js:$vars.investigator.output.reproduced"
        },
        "hypothesis": {
          "type": "string",
          "source": "=js:$vars.investigator.output.hypothesis"
        },
        "evidence": {
          "type": "string",
          "source": "=js:$vars.investigator.output.evidence"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "edge_start_output_investigator_input",
      "sourceNodeId": "start",
      "sourcePort": "output",
      "targetNodeId": "investigator",
      "targetPort": "input"
    },
