              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "parseStatusPr",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Parse pr status",
        "subLabel": "",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "expression": "// The runner prints exactly one STATUS_JSON= line, last. Parse that line and nothing else;\n// its absence means the runner itself broke.\nconst out = $vars.openPr.output || {};\nconst lines = String(out.Stdout || '').split('\\n');\nfor (let i = lines.length - 1; i >= 0; i--) {\n  const l = lines[i].trim();\n  if (l.startsWith('STATUS_JSON=')) {\n    try { return JSON.parse(l.slice('STATUS_JSON='.length)); } catch (e) { break; }\n  }\n}\nreturn { runnerFailed: true, exitCode: out.ExitCode, blobPath: out.OutputBlobPath || '' };",
          "fieldType": "string"
        }
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "decisionReproRan",
      "type": "core.logic.decision",
      "typeVersion": "1.3",
      "display": {
        "label": "Repro ran?",
        "subLabel": "",
        "icon": "trending-up-down"
      },
      "inputs": {
        "trueLabel": "True",
        "falseLabel": "False",
        "expression": {
          "type": "jsExpression",
          "expression": "($vars.parseStatusRepro.output || {})['runnerFailed'] !== true",
          "fieldType": "boolean"
        }
      }
    },
    {
      "id": "decisionInvestigated",
      "type": "core.logic.decision",
      "typeVersion": "1.3",
      "display": {
        "label": "Investigation ran?",
        "subLabel": "",
        "icon": "trending-up-down"
      },
      "inputs": {
        "trueLabel": "True",
        "falseLabel": "False",
        "expression": {
          "type": "jsExpression",
          "expression": "($vars.parseStatusInvestigate.output || {})['runnerFailed'] !== true",
          "fieldType": "boolean"
        }
      }
    }
  ],
