    {
      "id": "decisionTest",
      "type": "core.logic.decision",
      "typeVersion": "1.3",
      "display": {
        "label": "Test failed?",
        "subLabel": "",
        "icon": "trending-up-down"
      },
      "inputs": {
        "trueLabel": "True",
        "falseLabel": "False",
        "expression": {
          "type": "jsExpression",
          "expression": "$vars.runTest.output.ExitCode !== 0 && $vars.runTest.output.ExitCode !== 124",
          "fieldType": "boolean"
        }
      }
    },
    {
      "id": "endNotReproduced",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End: not reproduced / timeout",
        "subLabel": "",
        "icon": "circle-check"
      },
      "inputs": {},
      "outputs": {
        "hypothesis": {
          "source": {
            "type": "jsExpression",
            "expression": "$vars.runTest.output.ExitCode === 124 ? 'infrastructure: test run hit the ' + $vars.runTest.output.ExitCode + ' timeout (exit 124) on the VM; nothing was investigated.' : 'flake: the failing test passed on re-run (exit code 0); not reproduced, nothing to investigate.'",
            "fieldType": "string"
          },
          "type": "string"
        },
        "evidence": {
          "source": {
            "type": "jsExpression",
            "expression": "'CLASSIFICATION: ' + ($vars.runTest.output.ExitCode === 124 ? 'infrastructure' : 'flake') + '\\n\\nTest run tail:\\n' + ($vars.runTest.output.Stdout ?? '').slice(-3000) + '\\n\\nFull log: ' + $vars.runTest.output.OutputBlobPath",
            "fieldType": "string"
          },
          "type": "string"
        },
        "reproduced": {
          "source": {
            "type": "jsExpression",
            "expression": "false",
            "fieldType": "boolean"
          },
          "type": "string"
        },
        "patch": {
          "source": {
            "type": "jsExpression",
            "expression": "''",
            "fieldType": "string"
          },
          "type": "string"
        },
        "fixVerified": {
          "source": {
            "type": "jsExpression",
            "expression": "false",
            "fieldType": "boolean"
          },
          "type": "boolean"
        },
        "prUrl": {
          "source": {
            "type": "jsExpression",
            "expression": "''",
            "fieldType": "string"
          },
          "type": "string"
        },
        "iteration": {
          "source": {
            "type": "jsExpression",
            "expression": "$vars.iteration",
            "fieldType": "number"
          },
          "type": "number"
        },
        "fixAttempts": {
          "source": {
            "type": "jsExpression",
            "expression": "$vars.fixAttempts",
            "fieldType": "number"
          },
          "type": "number"
        }
      }
    },
    {
      "id": "ciHistoryInstructions",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "CI history script",
        "subLabel": "GitHub Actions job logs, last 8 nightlies",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "expression": "if ($vars.start.output.smokeOnly) { return `Write-Output '[ci-history] {\"classification\":\"flaky\",\"summary\":\"smoke stub\",\"firstFailSha\":\"\",\"lastPassSha\":\"\",\"runs\":[],\"ciFailureExcerpt\":\"smoke stub: no CI lookup\",\"ciJobLog\":\"\"}'\n`; }\nreturn `$ErrorActionPreference = 'Continue'\n# GH_TOKEN asset may hold a placeholder; take the first token GitHub actually accepts\n$token = $null\nforeach ($cand in @($env:GH_TOKEN, $env:GIT_TOKEN)) {\n  if (-not $cand) { continue }\n  try { Invoke-RestMethod https://api.github.com/user -Headers @{ Authorization = \"Bearer $cand\"; 'User-Agent' = 'vm-agent' } | Out-Null; $token = $cand; break } catch { }\n}\n$repoUrl = '${$vars.start.output.repoUrl}'\n$branch = '${$vars.start.output.branch}'\n$cmd = '${String($vars.start.output.testCommand || '').replace(/'/g, \"''\")}'\n$ctx = 'C:\\\\vm-agent\\\\ctx\\\\${$vars.deriveRunId.output}'\nNew-Item -ItemType Directory -Force -Path $ctx | Out-Null\n$r = [ordered]@{ classification = 'unknown'; summary = ''; firstFailSha = ''; lastPassSha = ''; runs = @(); ciFailureExcerpt = ''; ciJobLog = '' }\nfunction Finish { Write-Output ('[ci-history] ' + ($r | ConvertTo-Json -Compress -Depth 5)); exit 0 }\nif (-not $token) { $r.summary = 'neither GH_TOKEN nor GIT_TOKEN on the VM is accepted by GitHub; CI history unavailable'; Finish }\n$m = [regex]::Match($repoUrl, 'github\\\\.com[/:]([^/]+)/([^/.]+)')\nif (-not $m.Success) { $r.summary = 'repository is not on github.com; CI history unavailable'; Finish }\n$owner = $m.Groups[1].Value; $repo = $m.Groups[2].Value\n$specPath = [regex]::Match($cmd, '([\\\\w./-]+\\\\.spec\\\\.ts)').Groups[1].Value\n$project = [regex]::Match($cmd, '--project[= ]([\\\\w-]+)').Groups[1].Value\nif (-not $specPath) { $r.summary = 'no *.spec.ts in the test command; CI history unavailable'; Finish }\n$spec = Split-Path $specPath -Leaf\n$h = @{ Authorization = \"Bearer $token\"; Accept = 'application/vnd.github+json'; 'User-Agent' = 'vm-agent' }\n$api = \"https://api.github.com/repos/$owner/$repo\"\n# ponytail: nightly workflow file is fixed; make it a flow input if a second repo ever uses this flow\ntry { $runs = (Invoke-RestMethod \"$api/actions/workflows/playwright-ci.yml/runs?event=schedule&branch=$branch&per_page=8\" -Headers $h).workflow_runs }\ncatch { $r.summary = 'GitHub API error listing runs: ' + $_.Exception.Message; Finish }\n$fail = [string][char]0x2718; $pass = [string][char]0x2713\n$rx = '^(?:\\\\S+Z )?\\\\s*([' + $fail + $pass + '-])\\\\s+\\\\d+\\\\s+\\\\[[^\\\\]]+\\\\]\\\\s+\\\\S+\\\\s+(\\\\S*' + [regex]::Escape($spec) + ':\\\\d+:\\\\d+)'\nfunction Get-JobLog($jobId, $path) {\n  $url = \"$api/actions/jobs/$jobId/logs\"\n  try { Invoke-WebRequest $url -Headers $h -UseBasicParsing -OutFile $path; return $true } catch { }\n  try { Invoke-WebRequest $url -Headers $h -UseBasicParsing -MaximumRedirection 0 -ErrorAction Stop | Out-Null } catch {\n    $loc = $_.Exception.Response.Headers['Location']\n    if ($loc) { try { Invoke-WebRequest $loc -UseBasicParsing -OutFile $path; return $true } catch { } }\n  }\n  Write-Output \"[ci-history] could not fetch log for job $jobId\"\n  return $false\n}\n$savedLog = $false\nforeach ($run in $runs) {\n  $sha = $run.head_sha.Substring(0, 7); $date = ([datetime]$run.created_at).ToUniversalTime().ToString('yyyy-MM-dd')\n  $marks = @{}\n  try { $jobs = (Invoke-RestMethod \"$api/actions/runs/$($run.id)/jobs?per_page=100\" -Headers $h).jobs } catch { $jobs = @() }\n  $jobs = @($jobs | Where-Object { $_.name -like '*E2E*' })\n  if ($project) { $jobs = @($jobs | Where-Object { $_.name -like \"*($project)*\" }) }\n  foreach ($job in $jobs) {\n    $tmp = Join-Path $env:TEMP ('ci-' + $job.id + '.log')\n    if (-not (Get-JobLog $job.id $tmp)) { continue }\n    $sawFail = $false\n    foreach ($line in [System.IO.File]::ReadLines($tmp)) {\n      $mm = [regex]::Match($line, $rx)\n      if (-not $mm.Success) { continue }\n      $k = $mm.Groups[2].Value\n      $mark = switch ($mm.Groups[1].Value) { $fail { 'F'; $sawFail = $true } $pass { 'P' } default { 'S' } }\n      $marks[$k] = [string]$marks[$k] + $mark\n    }\n    if ($sawFail -and -not $savedLog) {\n      $savedLog = $true\n      $r.ciJobLog = Join-Path $ctx 'ci-job.log'\n      $clean = [System.IO.File]::ReadLines($tmp) | ForEach-Object { ($_ -replace '^\\\\S+Z ?', '') -replace '\\\\x1b\\\\[[0-9;]*m', '' }\n      [System.IO.File]::WriteAllLines($r.ciJobLog, [string[]]$clean)\n      $sb = New-Object System.Text.StringBuilder; $in = $false\n      $startRx = '^\\\\s*\\\\d+\\\\)\\\\s+\\\\[[^\\\\]]+\\\\]\\\\s+\\\\S+\\\\s+\\\\S*' + [regex]::Escape($spec)\n      foreach ($l in $clean) {\n        if ($l -match $startRx) { $in = $true }\n        elseif ($in -and ($l -match '^\\\\s*\\\\d+\\\\)\\\\s+\\\\[' -or $l -match '^\\\\s*\\\\d+ (failed|flaky|passed|skipped|did not run)')) { $in = $false }\n        if ($in) { [void]$sb.AppendLine($l); if ($sb.Length -gt 6000) { break } }\n      }\n      $r.ciFailureExcerpt = \"CI job: $($job.name) ($($job.html_url))\" + [Environment]::NewLine + $sb.ToString()\n    }\n    Remove-Item $tmp -ErrorAction SilentlyContinue\n  }\n  $verdict = 'absent'\n  if ($marks.Count -gt 0) {\n    $seqs = @($marks.Values | ForEach-Object { [string]$_ })\n    if ($seqs | Where-Object { $_.EndsWith('F') }) { $verdict = 'failed' }\n    elseif ($seqs | Where-Object { $_.EndsWith('P') -and $_.Contains('F') }) { $verdict = 'flaky' }\n    elseif ($seqs | Where-Object { $_.EndsWith('P') }) { $verdict = 'passed' }\n    else { $verdict = 'skipped' }\n  }\n  $r.runs += [ordered]@{ date = $date; sha = $sha; verdict = $verdict; url = $run.html_url }\n}\n$obs = @($r.runs | Where-Object { $_.verdict -in 'failed', 'flaky', 'passed' })\nif ($obs.Count -eq 0) { $r.classification = 'absent'; $r.summary = \"$spec did not run in the last $($r.runs.Count) scheduled runs of playwright-ci.yml on $branch\"; Finish }\n$streak = 0; foreach ($o in $obs) { if ($o.verdict -eq 'failed') { $streak++ } else { break } }\n$rest = @($obs | Select-Object -Skip $streak)\n$hasFlaky = @($obs | Where-Object { $_.verdict -eq 'flaky' }).Count -gt 0\n$restHasFail = @($rest | Where-Object { $_.verdict -eq 'failed' }).Count -gt 0\nif ($streak -gt 0) { $r.firstFailSha = $obs[$streak - 1].sha }\nif ($rest.Count -gt 0) { $r.lastPassSha = @($rest | Where-Object { $_.verdict -ne 'failed' })[0].sha }\nif ($streak -eq $obs.Count) { $r.classification = 'consistent' }\nelseif ($streak -gt 0 -and -not $hasFlaky -and -not $restHasFail) { $r.classification = 'regression' }\nelseif ($streak -eq 0 -and -not $hasFlaky -and -not $restHasFail) { $r.classification = 'passing' }\nelse { $r.classification = 'flaky' }\n$hist = ($r.runs | ForEach-Object { \"$($_.date) $($_.sha) $($_.verdict)\" }) -join '; '\n$r.summary = \"$($r.classification): $spec over the last $($r.runs.Count) nightly runs (newest first): $hist\"\nif ($r.firstFailSha) { $r.summary += \"; failing since $($r.firstFailSha)\" }\nif ($r.lastPassSha) { $r.summary += \"; last pass $($r.lastPassSha)\" }\nFinish\n`",
          "fieldType": "string"
        }
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "ciHistory",
      "type": "uipath.core.rpa-workflow.209d4dde-a982-4fc5-a498-4f818f667453",
      "typeVersion": "1.0.0",
      "display": {
        "label": "CI history for this spec",
        "subLabel": "nightly verdicts via GitHub API",
        "icon": "rpa"
      },
      "inputs": {
        "Script": {
          "type": "jsExpression",
          "expression": "$vars.ciHistoryInstructions.output",
          "fieldType": "string"
        },
        "WorkDir": "C:\\vm-agent",
        "RunId": "=js:$vars.deriveRunId.output + '/ci-history'",
        "TimeoutMinutes": 10,
        "MaxOutputChars": 16000
      },
      "outputs": {
        "output": {
          "type": "object",
          "source": "=this",
          "var": "output",
          "description": "Process output arguments (ExitCode, Stdout, OutputBlobPath)",
          "schema": {
            "type": "object",
            "properties": {
              "ExitCode": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              "Stdout": {
                "type": "string"
              },
              "OutputBlobPath": {
                "type": "string"
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "classifyFailure",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Classify failure",
        "subLabel": "regression | consistent | flaky | passing | absent | unknown",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "expression": "const out = $vars.ciHistory.output || {};\nconst m = String(out.Stdout || '').match(/\\[ci-history\\] (\\{.*\\})\\s*$/m);\nlet r = null;\nif (m) { try { r = JSON.parse(m[1]); } catch (e) { r = { classification: 'unknown', summary: 'ci-history JSON unparsable' }; } }\nif (!r) r = { classification: 'unknown', summary: 'ci-history step returned no result (exit ' + out.ExitCode + ')' };\nreturn {\n  classification: r.classification,\n  summary: r.summary || '',\n  firstFailSha: r.firstFailSha || '',\n  lastPassSha: r.lastPassSha || '',\n  ciFailureExcerpt: r.ciFailureExcerpt || '',\n  ciJobLog: r.ciJobLog || '',\n  // Repro only when CI history cannot settle it: a deterministic or flaky verdict from CI is the evidence.\n  needsRepro: !['regression', 'consistent', 'flaky'].includes(r.classification),\n};",
          "fieldType": "string"
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
          "schema": {
            "type": "object",
            "properties": {
              "classification": {
                "type": "string"
              },
              "needsRepro": {
                "type": "boolean"
              },
              "summary": {
                "type": "string"
              },
              "firstFailSha": {
                "type": "string"
              },
              "lastPassSha": {
                "type": "string"
              },
              "ciFailureExcerpt": {
                "type": "string"
              },
              "ciJobLog": {
                "type": "string"
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "decisionRepro",
      "type": "core.logic.decision",
      "typeVersion": "1.3",
      "display": {
        "label": "Repro needed?",
        "subLabel": "attempt repro if test is marked 'regression', 'consistent', 'flaky'.",
        "icon": "trending-up-down"
      },
      "inputs": {
        "trueLabel": "True",
        "falseLabel": "False",
        "expression": {
          "type": "jsExpression",
          "expression": "$vars.classifyFailure.output['needsRepro'] === true",
          "fieldType": "boolean"
        }
      }
    },
    {
      "id": "testEvidence",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Test evidence",
        "subLabel": "vm re-run or CI job log",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "expression": "const c = $vars.classifyFailure.output;\nif (c.needsRepro) {\n  const r = $vars.runTest.output;\n  return { source: 'vm', exitCode: r.ExitCode, stdout: r.Stdout, blobPath: r.OutputBlobPath, ciHistory: c.summary };\n}\nreturn { source: 'ci', exitCode: 1, stdout: c.ciFailureExcerpt || '(no CI failure excerpt captured; see ci-job.log)', blobPath: $vars.ciHistory.output.OutputBlobPath, ciHistory: c.summary };",
          "fieldType": "string"
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
          "schema": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "exitCode": {
                "type": "integer"
              },
              "stdout": {
                "type": "string"
              },
              "blobPath": {
                "type": "string"
              },
              "ciHistory": {
                "type": "string"
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
