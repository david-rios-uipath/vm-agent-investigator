{
  "id": "31b0a5d8-7787-4c4d-84ca-a78490eb8e70",
  "version": "1.9",
  "name": "VmAgent",
  "runtime": "maestro",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger",
        "icon": "play"
      },
      "inputs": {
        "entryPointId": "9169d066-e626-4372-b2f6-fb1c45863eb4",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the process.",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End",
        "subLabel": "",
        "icon": "circle-check"
      },
      "inputs": {},
      "outputs": {
        "hypothesis": {
          "source": {
            "type": "jsExpression",
            "expression": "$vars.investigationSummarizer.output.hypothesis",
            "fieldType": "string"
          },
          "type": "string"
        },
        "evidence": {
          "source": {
            "type": "jsExpression",
            "expression": "$vars.investigationSummarizer.output.evidence",
            "fieldType": "string"
          },
          "type": "string"
        },
        "reproduced": {
          "source": {
            "type": "jsExpression",
            "expression": "$vars.investigationSummarizer.output.reproduced",
            "fieldType": "boolean"
          },
          "type": "string"
        },
        "patch": {
          "source": {
            "type": "jsExpression",
            "expression": "$vars.investigationSummarizer.output.patch",
            "fieldType": "string"
          },
          "type": "string"
        },
        "fixVerified": {
          "source": {
            "type": "jsExpression",
            "expression": "$vars.investigationSummarizer.output.fixVerified",
            "fieldType": "boolean"
          },
          "type": "boolean"
        },
        "prUrl": {
          "source": {
            "type": "jsExpression",
            "expression": "$vars.investigationSummarizer.output.prUrl",
            "fieldType": "string"
          },
          "type": "string"
        },
        "fixAttempts": {
          "source": {
            "type": "jsExpression",
            "expression": "$vars.fixAttempts",
            "fieldType": "number"
          },
          "type": "number"
        }
      }
    },
    {
      "id": "deriveRunId",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Derive runId",
        "subLabel": "<spec>-<utc stamp>",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "expression": "const resume = $vars.start.output.resumeRunId;\n// Resume mode: the state for that runId is already in the bucket, so the fix phase can\n// start straight from its notebook.\nif (resume) return resume;\nconst cmd = $vars.start.output.testCommand || '';\nconst m = cmd.match(/([\\w.-]+?)\\.spec\\.ts\\b/) || cmd.match(/([\\w.-]+?)\\.ts\\b/);\nconst slug = (m ? m[1] : 'run').replace(/[^\\w.-]/g, '-').slice(0, 40);\nconst d = new Date(); const p = (n) => String(n).padStart(2, '0');\nreturn `${slug}-${d.getUTCFullYear()}${p(d.getUTCMonth() + 1)}${p(d.getUTCDate())}-${p(d.getUTCHours())}${p(d.getUTCMinutes())}${p(d.getUTCSeconds())}`;",
          "fieldType": "string"
        }
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "investigationSummarizer",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.4",
      "display": {
        "label": "Investigation Summarizer",
        "subLabel": "",
        "shape": "rectangle",
        "icon": "autonomous-agent"
      },
      "inputs": {
        "systemPrompt": "You write the final report for an automated e2e test investigation. You have no tools.\nYou are given: the failing test command, the repro phase's exit code, output excerpt and CI\nhistory, the investigator's notebook, and the fix, verification and PR results.\n\nBase every claim on the notebook and the repro output. Never invent a cause the notebook does\nnot support.\n\nSet classification to:\n  - regression: the notebook identifies a code change that breaks the test\n  - flake: timing/ordering dependent, passes on retry, no code cause\n  - infrastructure: the VM, licensing, environment or tooling caused it, not the product\n  - known-platform-issue: a known Studio Web / Orchestrator / solution failure\n  - inconclusive: the notebook does not establish a cause\n\nIf the notebook is missing or empty, set classification to inconclusive, say so in unverified,\nand report what the repro output alone shows.\n\nQuote decisive error lines in evidence, with file:line where the notebook has them. State\nplainly in unverified what remains unchecked. An honest gap is more useful than a confident\nguess.",
        "userPrompt": "Test command: {{ start__output__testCommand }}\nRepository: {{ start__output__repoUrl }} @ {{ start__output__branch }}\nRepro exit code: {{ repro__exitCode }}\nFull repro log in bucket: {{ repro__blobPath }}\nFix attempts used: {{ fixAttempts }}\n\nCI history for this spec: {{ repro__ciHistory }}\n\nRepro output excerpt: {{ repro__excerpt }}\n\nInvestigator notebook: {{ investigate__notebook }}\n\nFix attempt (may be empty if no fix was attempted): {{ fix__fixSummary }} (confidence {{ fix__confidence }})\nFix verified: {{ fix__fixVerified }}\nPatch (may be empty): {{ fix__patch }}\nPR URL (may be empty if no PR was opened): {{ pr__prUrl }}\n\nWrite the final report. Base every claim on the notebook and the repro output above, and fill\nevery field of the output schema.\n\nSet patch to the patch above verbatim, or empty if there is none. Set fixVerified to the value\nabove. Set prUrl to the URL above, or the empty string.",
        "model": "anthropic.claude-opus-4-8",
        "mode": "standard",
        "temperature": 0,
        "maxTokenPerResponse": 16384,
        "maxIterations": 25,
        "isConversational": false,
        "guardrails": [],
        "name": "Investigation Summarizer",
        "agentInputVariables": [
          {
            "id": "start__output__testCommand",
            "type": "string",
            "binding": "=$vars.start.output.testCommand"
          },
          {
            "id": "start__output__repoUrl",
            "type": "string",
            "binding": "=$vars.start.output.repoUrl"
          },
          {
            "id": "start__output__branch",
            "type": "string",
            "binding": "=$vars.start.output.branch"
          },
          {
            "id": "repro__exitCode",
            "type": "number",
            "binding": "=$vars.parseStatusRepro?.output?.exitCode ?? -1"
          },
          {
            "id": "repro__excerpt",
            "type": "string",
            "binding": "=$vars.parseStatusRepro?.output?.excerpt ?? ''"
          },
          {
            "id": "repro__ciHistory",
            "type": "string",
            "binding": "=$vars.parseStatusRepro?.output?.ciHistory ?? ''"
          },
          {
            "id": "repro__blobPath",
            "type": "string",
            "binding": "=$vars.repro?.output?.OutputBlobPath ?? ''"
          },
          {
            "id": "investigate__notebook",
            "type": "string",
            "binding": "=$vars.parseStatusInvestigate?.output?.notebook ?? ''"
          },
          {
            "id": "fix__fixSummary",
            "type": "string",
            "binding": "=$vars.parseStatusFix?.output?.fixSummary ?? ''"
          },
          {
            "id": "fix__confidence",
            "type": "string",
            "binding": "=$vars.parseStatusFix?.output?.confidence ?? ''"
          },
          {
            "id": "fix__fixVerified",
            "type": "boolean",
            "binding": "=$vars.parseStatusFix?.output?.fixVerified ?? false"
          },
          {
            "id": "fix__patch",
            "type": "string",
            "binding": "=$vars.parseStatusFix?.output?.patch ?? ''"
          },
          {
            "id": "pr__prUrl",
            "type": "string",
            "binding": "=$vars.parseStatusPr?.output?.prUrl ?? ''"
          },
          {
            "id": "fixAttempts",
            "type": "number",
            "binding": "=$vars.fixAttempts"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "reproduced",
            "type": "boolean",
            "required": true
          },
          {
            "id": "hypothesis",
            "type": "string",
            "required": true
          },
          {
            "id": "evidence",
            "type": "string",
            "required": true
          },
          {
            "id": "patch",
            "type": "string",
            "required": true,
            "description": "The diff verbatim from the ### patch section of the verification output, or empty"
          },
          {
            "id": "fixVerified",
            "type": "boolean",
            "required": true,
            "description": "true only if the verification output contains FIX_VERIFIED=true"
          },
          {
            "id": "prUrl",
            "type": "string",
            "required": true,
            "description": "The value after PR_URL= in the PR step output, or empty"
          }
        ],
        "source": "ee9f4167-4fc2-4b1b-a1a7-dfb48a9bfff4"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "decisionVerify",
      "type": "core.logic.decision",
      "typeVersion": "1.3",
      "display": {
        "label": "Fix verified or out of attempts?",
        "subLabel": "",
        "icon": "trending-up-down"
      },
      "inputs": {
        "trueLabel": "True",
        "falseLabel": "False",
        "expression": {
          "type": "jsExpression",
          "expression": "($vars.parseStatusFix.output || {})['fixVerified'] === true || $vars.fixAttempts >= $vars.start.output.maxFixAttempts",
          "fieldType": "boolean"
        }
      }
    },
    {
      "id": "bumpFixAttempts",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Bump fix attempts",
        "subLabel": "",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "expression": "return $vars.fixAttempts + 1",
          "fieldType": "string"
        }
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "decisionPr",
      "type": "core.logic.decision",
      "typeVersion": "1.3",
      "display": {
        "label": "Fix verified?",
        "subLabel": "",
        "icon": "trending-up-down"
      },
      "inputs": {
        "trueLabel": "True",
        "falseLabel": "False",
        "expression": {
          "type": "jsExpression",
          "expression": "($vars.parseStatusFix.output || {})['fixVerified'] === true",
          "fieldType": "boolean"
        }
      }
    },
    {
      "id": "endSetupFailed",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End: setup failed",
        "subLabel": "",
        "icon": "circle-check"
      },
      "inputs": {},
      "outputs": {
        "hypothesis": {
          "source": {
            "type": "jsExpression",
            "expression": "'infrastructure: a phase runner job returned no STATUS_JSON line, so it broke before it could report; nothing was investigated.'",
            "fieldType": "string"
          },
          "type": "string"
        },
        "evidence": {
          "source": {
            "type": "jsExpression",
            "expression": "'CLASSIFICATION: infrastructure\\n\\nFull exec log: ' + ((($vars.parseStatusInvestigate.output ?? {}).runnerFailed ? ($vars.parseStatusInvestigate.output ?? {}).blobPath : ($vars.parseStatusRepro.output ?? {}).blobPath) ?? '(none)')",
            "fieldType": "string"
          },
          "type": "string"
        },
        "reproduced": {
          "source": {
            "type": "jsExpression",
            "expression": "false",
            "fieldType": "boolean"
          },
          "type": "string"
        },
        "patch": {
          "source": {
            "type": "jsExpression",
            "expression": "''",
            "fieldType": "string"
          },
          "type": "string"
        },
        "fixVerified": {
          "source": {
            "type": "jsExpression",
            "expression": "false",
            "fieldType": "boolean"
          },
          "type": "boolean"
        },
        "prUrl": {
          "source": {
            "type": "jsExpression",
            "expression": "''",
            "fieldType": "string"
          },
          "type": "string"
        },
        "fixAttempts": {
          "source": {
            "type": "jsExpression",
            "expression": "$vars.fixAttempts",
            "fieldType": "number"
          },
          "type": "number"
        }
      }
    },
    {
      "id": "endNotReproduced",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End: not reproduced / timeout",
        "subLabel": "",
        "icon": "circle-check"
      },
      "inputs": {},
      "outputs": {
        "hypothesis": {
          "source": {
            "type": "jsExpression",
            "expression": "($vars.parseStatusRepro.output ?? {}).exitCode === 124 ? 'infrastructure: the test run hit the runner timeout (exit 124) on the VM; nothing was investigated.' : 'flake: the failing test passed on re-run (exit code 0); not reproduced, nothing to investigate.'",
            "fieldType": "string"
          },
          "type": "string"
        },
        "evidence": {
          "source": {
            "type": "jsExpression",
            "expression": "'CLASSIFICATION: ' + (($vars.parseStatusRepro.output ?? {}).exitCode === 124 ? 'infrastructure' : 'flake') + '\\n\\nCI history:\\n' + (($vars.parseStatusRepro.output ?? {}).ciHistory ?? '') + '\\n\\nTest run tail:\\n' + (($vars.parseStatusRepro.output ?? {}).excerpt ?? '')",
            "fieldType": "string"
          },
          "type": "string"
        },
        "reproduced": {
          "source": {
            "type": "jsExpression",
            "expression": "false",
            "fieldType": "boolean"
          },
          "type": "string"
        },
        "patch": {
          "source": {
            "type": "jsExpression",
            "expression": "''",
            "fieldType": "string"
          },
          "type": "string"
        },
        "fixVerified": {
          "source": {
            "type": "jsExpression",
            "expression": "false",
            "fieldType": "boolean"
          },
          "type": "boolean"
        },
        "prUrl": {
          "source": {
            "type": "jsExpression",
            "expression": "''",
            "fieldType": "string"
          },
          "type": "string"
        },
        "fixAttempts": {
          "source": {
            "type": "jsExpression",
            "expression": "$vars.fixAttempts",
            "fieldType": "number"
          },
          "type": "number"
        }
      }
    },
    {
      "id": "decisionRepro",
      "type": "core.logic.decision",
      "typeVersion": "1.3",
      "display": {
        "label": "Repro needed?",
        "subLabel": "attempt repro if test is marked 'regression', 'consistent', 'flaky'.",
        "icon": "trending-up-down"
      },
      "inputs": {
        "trueLabel": "True",
        "falseLabel": "False",
        "expression": {
          "type": "jsExpression",
          "expression": "($vars.parseStatusRepro.output || {})['reproduced'] === true",
          "fieldType": "boolean"
        }
      }
    },
    {
      "id": "decisionResume",
      "type": "core.logic.decision",
      "typeVersion": "1.3",
      "display": {
        "label": "Resume with existing notebook?",
        "subLabel": "",
        "icon": "trending-up-down"
      },
      "inputs": {
        "trueLabel": "True",
        "falseLabel": "False",
        "expression": {
          "type": "jsExpression",
          "expression": "!!$vars.start.output.resumeRunId",
          "fieldType": "boolean"
        }
      }
    },
    {
      "id": "sticky-1",
      "type": "stickyNote",
      "typeVersion": "1.0.0",
      "display": {},
      "inputs": {
        "color": "pink",
        "content": "## 1. Repro (CI history + local run)"
      }
    },
    {
      "id": "sticky-2",
      "type": "stickyNote",
      "typeVersion": "1.0.0",
      "display": {
        "label": "stickyNote"
      },
      "inputs": {
        "color": "yellow",
        "content": "## 2. Investigate on the VM"
      }
    },
    {
      "id": "sticky-3",
      "type": "stickyNote",
      "typeVersion": "1.0.0",
      "display": {},
      "inputs": {
        "color": "green",
        "content": "## 3. Fix and verify on the VM"
      }
    },
    {
      "id": "sticky-4",
      "type": "stickyNote",
      "typeVersion": "1.0.0",
      "display": {
        "label": "stickyNote"
      },
      "inputs": {
        "color": "white",
        "content": "## 4. Open a draft PR"
      }
    },
    {
      "id": "bootstrapRepro",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Bootstrap repro",
        "subLabel": "",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "expression": "// The VM gets the phase logic from this repo, not from the flow: a runner change is a git\n// push, not a solution release. `runnerRef` selects the ref to run.\nconst s = (v) => String(v ?? '').replace(/'/g, \"''\");\nconst runId = s($vars.deriveRunId.output);\nconst ref = s($vars.start.output.runnerRef || 'master');\nconst args = [\n  \"-Phase repro\",\n  `-RunId '${runId}'`,\n  `-RepoUrl '${s($vars.start.output.repoUrl)}'`,\n  `-Branch '${s($vars.start.output.branch)}'`,\n  `-TestCommand '${s($vars.start.output.testCommand)}'`,\n  $vars.start.output.claudeModel ? `-Model '${s($vars.start.output.claudeModel)}'` : \"\",\n  $vars.start.output.smokeOnly ? \"-SmokeOnly\" : \"\",\n].join(' ');\nreturn `$ErrorActionPreference = 'Continue'\n$runner = 'C:\\\\vm-agent\\\\runner'\n$url = '${s($vars.start.output.runnerRepoUrl)}'\nif (-not $url) { Write-Output '[bootstrap] runnerRepoUrl is empty; nothing to clone'; exit 1 }\nif ($env:GIT_TOKEN) { $url = $url -replace '^https://', \"https://x-access-token:$($env:GIT_TOKEN)@\" }\nif (-not (Test-Path \"$runner\\\\.git\")) {\n  git clone --depth 1 $url $runner\n  if ($LASTEXITCODE -ne 0) { Write-Output '[bootstrap] clone of the runner repo failed'; exit 1 }\n}\ngit -C $runner remote set-url origin $url\ngit -C $runner fetch --depth 1 origin ${ref}\nif ($LASTEXITCODE -ne 0) { Write-Output '[bootstrap] fetch of the runner repo failed'; exit 1 }\ngit -C $runner checkout -q FETCH_HEAD\ngit -C $runner remote set-url origin '${s($vars.start.output.runnerRepoUrl)}'\nWrite-Output \"[bootstrap] runner at $(git -C $runner rev-parse --short HEAD)\"\n& \"$runner\\\\vm\\\\run-phase.ps1\" ${args}\nexit $LASTEXITCODE\n`",
          "fieldType": "string"
        }
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "repro",
      "type": "uipath.core.rpa-workflow.ca36341d-ecec-4ba6-aa76-134d0afe4ba7",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Repro",
        "subLabel": "",
        "icon": "rpa"
      },
      "inputs": {
        "Script": {
          "type": "jsExpression",
          "expression": "$vars.bootstrapRepro.output",
          "fieldType": "string"
        },
        "WorkDir": {
          "type": "literal",
          "expression": "C:\\vm-agent",
          "fieldType": "string"
        },
        "RunId": {
          "type": "jsExpression",
          "expression": "$vars.deriveRunId.output",
          "fieldType": "string"
        },
        "StateKey": {
          "type": "jsExpression",
          "expression": "$vars.deriveRunId.output + '/state.zip'",
          "fieldType": "string"
        },
        "TimeoutMinutes": {
          "type": "literal",
          "expression": "15",
          "fieldType": "number"
        },
        "MaxOutputChars": 32000
