          },
          {
            "id": "hypothesis",
            "type": "string"
          },
          {
            "id": "evidence",
            "type": "string"
          }
        ],
        "source": "e41af830-1e4b-4d6b-a7e0-5595f152ea88"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
