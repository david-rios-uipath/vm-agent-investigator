{
  "id": "31b0a5d8-7787-4c4d-84ca-a78490eb8e70",
  "version": "1.9",
  "name": "VmAgent",
  "runtime": "maestro",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger",
        "icon": "play"
      },
      "inputs": {
        "entryPointId": "9169d066-e626-4372-b2f6-fb1c45863eb4",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the process.",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "id": "setupVm",
      "type": "uipath.core.rpa-workflow.209d4dde-a982-4fc5-a498-4f818f667453",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Set up VM (clone + install)",
        "subLabel": "",
        "icon": "rpa"
      },
      "inputs": {
        "Script": {
          "type": "jsExpression",
          "expression": "$vars.setupInstructions.output",
          "fieldType": "string"
        },
        "WorkDir": "C:\\vm-agent",
        "RunId": "=js:$vars.deriveRunId.output + '/setup'",
        "TimeoutMinutes": 30,
        "MaxOutputChars": 4000
      },
      "outputs": {
        "output": {
          "type": "object",
          "source": "=this",
          "var": "output",
          "description": "Process output arguments (ExitCode, Stdout, OutputBlobPath)",
          "schema": {
            "type": "object",
            "properties": {
              "ExitCode": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              "Stdout": {
                "type": "string"
              },
              "OutputBlobPath": {
                "type": "string"
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "runTest",
      "type": "uipath.core.rpa-workflow.209d4dde-a982-4fc5-a498-4f818f667453",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Run failing test",
        "subLabel": "",
        "icon": "rpa"
      },
      "inputs": {
        "Script": {
          "type": "jsExpression",
          "expression": "$vars.testRunInstructions.output",
          "fieldType": "string"
        },
        "WorkDir": "C:\\vm-agent",
        "RunId": "=js:$vars.deriveRunId.output + '/test'",
        "TimeoutMinutes": 45,
        "MaxOutputChars": 16000
      },
      "outputs": {
        "output": {
          "type": "object",
          "source": "=this",
          "var": "output",
          "description": "Process output arguments (ExitCode, Stdout, OutputBlobPath)",
          "schema": {
            "type": "object",
            "properties": {
              "ExitCode": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              "Stdout": {
                "type": "string"
              },
              "OutputBlobPath": {
                "type": "string"
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "vmExecTool",
      "type": "uipath.agent.resource.tool.process.209d4dde-a982-4fc5-a498-4f818f667453",
      "typeVersion": "1.0.0",
      "display": {
        "label": "vm-exec",
        "subLabel": "",
        "icon": "rpa"
      },
      "inputs": {
        "source": "29664e8a-bd00-4e62-889b-cc98493010d4",
        "id": "vmExecTool",
        "name": "vm_exec",
        "description": "Run a PowerShell script on the Windows robot VM and get its output. The VM is a persistent Windows Server with git, node, corepack/pnpm and rg (ripgrep) on PATH; the repo is at C:\\vm-agent\\repo. Returns the exit code, the last 8000 chars of merged stdout+stderr, and the bucket path of the complete log. WorkDir, RunId and a 3-minute timeout are fixed by the flow. Each call costs 45-75 seconds of fixed overhead regardless of script length, so batch: one call should run every command a step needs, with Write-Output '### <label>' separators. Output is capped at 8000 chars, so filter (rg -n, Select-String, Select-Object -First N, Get-Content -TotalCount N) instead of dumping whole files.",
        "guardrails": [],
        "isEnabled": true,
        "referenceKey": "209d4dde-a982-4fc5-a498-4f818f667453",
        "inputSchema": {
          "type": "object",
          "properties": {
            "Script": {
              "type": "string",
              "description": "PowerShell script to run on the VM. Multiple lines allowed. Runs with powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass. Batch several commands per script (with Write-Output '### <label>' separators and $ErrorActionPreference = 'Continue'); one command per call wastes the ~40 s fixed cost of each call."
            },
            "WorkDir": {
              "type": "string",
              "description": "Working directory on the VM. Fixed by the flow (C:\\vm-agent); do not set."
            },
            "RunId": {
              "type": "string",
              "description": "Log grouping prefix in the storage bucket. Fixed by the flow; do not set."
            },
            "TimeoutMinutes": {
              "type": "number",
              "description": "Fixed by the flow at 3 minutes; do not set. Exit code 124 means it timed out."
            },
            "guardrails": {
              "type": "array"
            }
          },
          "required": [
            "Script"
          ]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "ExitCode": {
              "type": "integer",
              "description": "0 = success, 124 = timeout, -1 = runner exception"
            },
            "Stdout": {
              "type": "string",
              "description": "Merged stdout+stderr, tail-truncated to 8000 chars; full log in the bucket at OutputBlobPath"
            },
            "OutputBlobPath": {
              "type": "string",
              "description": "Path of the complete log inside the e2e-investigations bucket"
            }
          }
        },
        "properties": {
          "folderPath": "e2e-investigator",
          "processName": "vm-exec-vm",
          "exampleCalls": []
        },
        "argumentProperties": {
          "$['WorkDir']": {
            "variant": "static",
            "value": "C:\\vm-agent",
            "isSensitive": false
          },
          "$['RunId']": {
            "variant": "argument",
            "argumentPath": "$['deriveRunId__output']",
            "isSensitive": false
          },
          "$['TimeoutMinutes']": {
            "variant": "static",
            "value": "3",
            "isSensitive": false
          }
        },
        "settings": {},
        "folderPath": "e2e-investigator",
        "Script": {
          "mode": "prompt",
          "textValue": "",
          "promptValue": "PowerShell script to run on the VM. Multiple lines allowed. Runs with powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass. Batch several commands per script (with Write-Output '### <label>' separators and $ErrorActionPreference = 'Continue'); one command per call wastes the ~40 s fixed cost of each call.",
          "argumentPath": ""
        },
        "WorkDir": {
          "mode": "text-builder",
          "textValue": "C:\\vm-agent",
          "promptValue": "",
          "argumentPath": ""
        },
        "RunId": {
          "mode": "variable",
          "textValue": "",
          "promptValue": "",
          "argumentPath": "$vars.deriveRunId.output"
        },
        "TimeoutMinutes": {
          "mode": "text-builder",
          "textValue": "3",
          "promptValue": "",
          "argumentPath": ""
        }
      }
    },
    {
      "id": "end",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End",
        "subLabel": "",
        "icon": "circle-check"
      },
      "inputs": {},
      "outputs": {
        "hypothesis": {
          "source": {
            "type": "jsExpression",
            "expression": "$vars.investigationSummarizer.output.hypothesis",
            "fieldType": "string"
          },
          "type": "string"
        },
        "evidence": {
          "source": {
            "type": "jsExpression",
            "expression": "$vars.investigationSummarizer.output.evidence",
            "fieldType": "string"
          },
          "type": "string"
        },
        "reproduced": {
          "source": {
            "type": "jsExpression",
            "expression": "$vars.investigationSummarizer.output.reproduced",
            "fieldType": "boolean"
          },
          "type": "string"
        },
        "patch": {
          "source": {
            "type": "jsExpression",
            "expression": "$vars.investigationSummarizer.output.patch",
            "fieldType": "string"
          },
          "type": "string"
        },
        "fixVerified": {
          "source": {
            "type": "jsExpression",
            "expression": "$vars.investigationSummarizer.output.fixVerified",
            "fieldType": "boolean"
          },
          "type": "boolean"
        },
        "prUrl": {
          "source": {
            "type": "jsExpression",
            "expression": "$vars.investigationSummarizer.output.prUrl",
            "fieldType": "string"
          },
          "type": "string"
        },
        "iteration": {
          "source": {
            "type": "jsExpression",
            "expression": "$vars.iteration",
            "fieldType": "number"
          },
          "type": "number"
        },
        "fixAttempts": {
          "source": {
            "type": "jsExpression",
            "expression": "$vars.fixAttempts",
            "fieldType": "number"
          },
          "type": "number"
        }
      }
    },
    {
      "id": "investigator",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.4",
      "display": {
        "label": "Investigator",
        "subLabel": "",
        "shape": "rectangle",
        "icon": "autonomous-agent"
      },
      "inputs": {
        "systemPrompt": "You investigate failing end-to-end tests by running PowerShell on a Windows robot VM through the\n  vm_exec tool. The repository is already cloned at C:\\vm-agent\\repo. The run context, tools, and\n  procedure for this pass are in the user message.\n\n  Invariants, every pass:\n  - The notebook on the VM is the deliverable. Your output fields only control whether the loop\n    runs again; anything not written to the notebook is lost.\n  - Batch. Every vm_exec call costs 45-75 seconds of fixed overhead (job start, robot slot,\n    resume) on top of the script itself, and each script is killed after 3 minutes. One\n    call = one complete step: a multi-command script that gathers everything the step needs,\n    with `Write-Output '### <label>'` before each command. Never spend a call on a single\n    `git log`, `Get-Content` or `rg`.\n  - Filter, don't dump. The tool returns at most 8000 chars; everything you read stays in your\n    context for the rest of the run. Use `rg -n`, `Select-String`, `Select-Object -First N`,\n    `Get-Content -TotalCount N` and line ranges. Never print a whole source file, trace or log.\n  - Reads only. Never run interactive commands, install global packages, or modify remote state\n    (no git push, publish, branch deletion).\n  - Prefer evidence over theory: run the script that could falsify a claim, quote error lines\n    verbatim with file:line, and record environment failures (missing tool, auth, network) in the\n    notebook instead of working around them silently.\n  - If any value in the run context is blank, do not invent one. Record it in the notebook,\n    return investigationComplete=false, and name the missing field in rationale.",
        "userPrompt": "   Current pass: {{ $vars.iteration }} of {{ $vars.start.output.maxIterations }}\n\n    Run context:\n    - repository: {{ $vars.start.output.repoUrl }} @ {{ $vars.start.output.branch }}\n    - test command: {{ $vars.start.output.testCommand }}\n    - runId: {{ $vars.deriveRunId.output }}\n    - CI history for this spec: {{ $vars.testEvidence.output.ciHistory }}\n    - evidence source: {{ $vars.testEvidence.output.source }}\n    - test exit code: {{ $vars.testEvidence.output.exitCode }}\n    - full log bucket path: {{ $vars.testEvidence.output.blobPath }}\n    - test output tail:\n    {{ $vars.testEvidence.output.stdout }}\n\n    The repository has ALREADY been cloned and its dependencies installed at C:\\vm-agent\\repo on that VM.\n    Evidence source \"vm\" means the failing test command was re-run once on this VM: its exit code, output\n    tail and full-log bucket path are in the run context above, and Playwright artifacts are under\n    C:\\vm-agent\\repo\\e2e\\test-results. Evidence source \"ci\" means CI history already settled that the\n    failure is deterministic or flaky, so the test was NOT re-run here: the output tail is the failure\n    section of the CI job log, the full CI job log is at C:\\vm-agent\\ctx\\{{ $vars.deriveRunId.output }}\\ci-job.log,\n    and there are NO local Playwright artifacts (no error-context.md, no trace.zip). Your job is to explain\n    WHY it failed, and to write that explanation into a notebook file on the VM.\n\n    THE NOTEBOOK IS THE DELIVERABLE.\n\n    Your report is not returned through your output fields. It is the file\n    C:\\vm-agent\\notes\\{{ $vars.deriveRunId.output }}\\NOTES.md on the VM. A later step reads that file and\n    writes the final report; anything not in it is lost. Your output fields only control whether the loop\n    runs again.\n\n    You have one tool. vm_exec runs a PowerShell script on the VM and returns its exit code, the last\n    8000 chars of output, and the bucket path of the full log. Working directory, runId and a hard\n    3-minute timeout per call are fixed by the flow — you only supply the script. The VM has git, node,\n    corepack/pnpm and rg on PATH. GitHub and Slack are reachable from the VM via env vars: GitHub REST with `-Headers @{ Authorization = \"Bearer $env:GH_TOKEN\" }` (CI runs, PR history, blame on GitHub), Slack Web API with `-Headers @{ Authorization = \"Bearer $env:SLACK_TOKEN\"; Cookie = \"d=$env:SLACK_COOKIE\" }` (browser-session token; both headers required) (prior reports / threads about this test). Use them only when local git history and artifacts cannot settle a leg; if a token is unset, say so in the notebook under Unchecked.\n\n    How to work:\n    1. Read the exit code and output tail in the run context first. Do not re-run the full suite to see\n    what you were already told.\n    1b. Use the CI history. \"regression\" or \"consistent\" with \"failing since <sha>\" and \"last pass <sha>\"\n       means the cause is a commit in that range: start with `git log --oneline <lastPass>..<firstFail>`\n       and `git show --stat` on the commits touching the spec's area (`git fetch --deepen 100` first if\n       a sha is missing from the shallow clone). \"flaky\" means look for timing, ordering and shared\n       state, not for a code change.\n    2. If this is not pass 1, C:\\vm-agent\\notes\\{{ $vars.deriveRunId.output }}\\NOTES.md is your own\n    record from an earlier pass. Read it as the FIRST lines of your first vm_exec script of this pass\n    (`Get-Content` it, then continue with the probes) — never as a separate call. Continue from it;\n    do not repeat work it already contains.\n    3. Work one leg at a time. A leg is a single causal claim — \"the undo count never advances\n       because the editor never fires the change event\", \"the prompt edit is written to a stale\n       store instance\". Stay on a leg until it is settled.\n\n       Each step of a leg:\n       a. State the claim you are testing.\n       b. Run ONE script that could FALSIFY it — print the value, read the artifact, check\n          the handler. Not a script that merely looks nearby. Put every probe the claim needs\n          into that one script: several `rg` searches, `git log`/`git show`, line ranges of the\n          files you expect to matter, all in one call, each preceded by\n          `Write-Output '### <label>'`. Set `$ErrorActionPreference = 'Continue'` so one\n          failing probe does not hide the others.\n       c. Record the verdict in the notebook: confirmed, refuted, or still open and why.\n       d. If the result narrows the SAME claim, keep going. That is the same leg, and there\n          is no reason to stop.\n\n       Going deeper is not a new leg. Symptom, then the assertion that produced it, then the\n       value the assertion read, then where that value is set — that is one leg, followed\n       properly. You may take as many steps as it needs.\n\n    4. Hand off when the leg is settled and the next claim is a different question. Not before.\n       A refuted leg is a completed leg: record what it ruled out, then hand off with the next\n       claim in nextFocus. Do not hand off mid-leg with an unverified guess — verify it or\n       record it as refuted first.\n\n    5. (evidence source vm only) Playwright artifacts are usually the fastest way to settle a leg about a UI assertion.\n       error-context.md and trace.zip under C:\\vm-agent\\repo\\e2e\\test-results\\... hold the DOM\n       and step trace at the moment of failure. Read them before theorizing about source, but\n       read them filtered: `Select-String` the DOM snapshot for the elements the assertion names,\n       and after `Expand-Archive` on trace.zip, `Select-String` trace.trace for the failing step —\n       never print a whole snapshot or trace. With evidence source ci, `Select-String` over ci-job.log\n       replaces them.\n    6. The clone carries 50 commits of history. `git log`, `git show --stat` and `git blame -L` work\n       locally and are the right way to find what changed in the failing area. If a git history command\n       returns suspiciously little — one commit for a file many people touch — say so in the notebook\n       rather than treating that single commit as the suspect. Avoid `git log --follow` on large files;\n       it is slow in a shallow clone.\n    7. Do not write fixes; a later step does that from your notebook. Make sure the notebook names the\n       exact file:line and mechanism a fixer would need.\n\n    8. Budget: aim for at most 6 vm_exec calls per pass; more than 12 means you are probing one\n       command at a time. The notebook append is the tail of your last probe script, not its own call. A script that exceeds 3 minutes is killed (exit code 124)\n       and its partial output returned — scope searches tightly rather than retrying the same command.\n\n    Searching the repo: use `rg` (ripgrep), which skips node_modules by default:\n\n        rg -n \"someSymbol\" --type ts packages/canvas e2e\n\n    Never use `Get-ChildItem -Recurse` or `Select-String -Path ... -Recurse` over packages/ or e2e/. They\n    walk into every node_modules in the monorepo and will hit the 3-minute kill.\n\n    Before you return, write the notebook. This is mandatory. Append it at the END of your last probe\n    script — the same vm_exec call — never as a separate call:\n\n      $dir = \"C:\\vm-agent\\notes\\{{ $vars.deriveRunId.output }}\"\n      New-Item -ItemType Directory -Force -Path $dir | Out-Null\n      $body = @'\n      ## Pass {{ $vars.iteration }}\n      Hypothesis: <one sentence, or \"no cause established\">\n      Decisive error lines: <quoted verbatim, with file:line>\n      Evidence: <what you ran and what it showed>\n      Artifacts read: <error-context.md / trace.zip paths, or \"none\">\n      Bucket logs: <every OutputBlobPath you used, including the one you were given>\n      Unchecked: <what a next pass should look at>\n      '@\n      Add-Content -Path \"$dir\\NOTES.md\" -Value $body\n\n    Append; never overwrite. Later passes add sections, they do not replace earlier ones. Quote error\n    lines verbatim rather than paraphrasing them. Write the notebook even when you found nothing — \"no\n    cause established, here is what I ruled out\" is a usable result; a missing file is not.\n\n    Rules:\n    - Never run interactive commands, never install global packages, never modify remote state (no git\n    push, no publish, no deleting branches).\n    - If the clone is unexpectedly missing (a different VM served your call), re-create it:\n    `git clone --depth 50 --branch {{ $vars.start.output.branch }} {{ $vars.start.output.repoUrl }} C:\\vm-agent\\repo`,\n    then continue.\n    - pnpm exists only through corepack. Use `corepack pnpm`, and run `corepack enable pnpm` first if a\n    subprocess needs a bare `pnpm` on PATH (Playwright's config.webServer does). A failure that is only\n    \"'pnpm' is not recognized\" is a VM environment artifact, not the CI failure you were asked to explain\n    — say so in the notebook.\n    - If a call fails for an environment reason (missing tool, auth failure, network error), record it in\n    the notebook rather than working around it silently.\n    - If any value in the run context is blank, do not invent one. Record the blank field in the\n    notebook, set investigationComplete false, and name the missing field in rationale.\n\n    Then return your output fields:\n\n    - investigationComplete: true only if the notebook now names a cause, or you have exhausted your vm_exec budget. Do not set it true merely because\n    you ran out of ideas on the first pass — that is what nextFocus is for.\n    - nextFocus: when investigationComplete is false, the single specific thing the next pass should do.\n    Empty when complete.\n    - rationale: why you set investigationComplete the way you did. Name the evidence that closed the\n    question, or the specific gap that keeps it open.",
        "model": "anthropic.claude-sonnet-5",
        "mode": "standard",
        "temperature": 0.05,
        "maxTokenPerResponse": 16384,
        "maxIterations": 100,
        "isConversational": false,
        "guardrails": [],
        "name": "Investigator",
        "agentInputVariables": [
          {
            "id": "start__output__repoUrl",
            "type": "string",
            "binding": "=$vars.start.output.repoUrl"
          },
          {
            "id": "start__output__branch",
            "type": "string",
            "binding": "=$vars.start.output.branch"
          },
          {
            "id": "start__output__testCommand",
            "type": "string",
            "binding": "=$vars.start.output.testCommand"
          },
          {
            "id": "start__output__runId",
            "type": "string",
            "binding": "=$vars.deriveRunId.output"
          },
          {
            "id": "testEvidence__output__exitCode",
            "type": "integer",
            "binding": "=$vars.testEvidence.output.exitCode"
          },
          {
            "id": "testEvidence__output__stdout",
            "type": "string",
            "binding": "=$vars.testEvidence.output.stdout"
          },
          {
            "id": "testEvidence__output__blobPath",
            "type": "string",
            "binding": "=$vars.testEvidence.output.blobPath"
          },
          {
            "id": "testEvidence__output__ciHistory",
            "type": "string",
            "binding": "=$vars.testEvidence.output.ciHistory"
          },
          {
            "id": "testEvidence__output__source",
            "type": "string",
            "binding": "=$vars.testEvidence.output.source"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "investigationComplete",
            "type": "boolean",
            "required": true
          },
          {
            "id": "nextFocus",
            "type": "string",
            "description": "What the next pass should focus on. Empty when investigation complete.",
            "required": true
          },
          {
            "id": "rationale",
            "type": "string",
            "description": "Why was the investigation marked as complete/not complete?",
            "required": true
          }
        ],
        "source": "e41af830-1e4b-4d6b-a7e0-5595f152ea88"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "deriveRunId",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Derive runId",
        "subLabel": "<spec>-<utc stamp>",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "expression": "const cmd = $vars.start.output.testCommand || '';\nconst m = cmd.match(/([\\w.-]+?)(?:\\.spec)?\\.ts\\b/);\nconst slug = (m ? m[1] : 'run').replace(/[^\\w.-]/g, '-').slice(0, 40);\nconst d = new Date(); const p = (n) => String(n).padStart(2, '0');\nreturn `${slug}-${d.getUTCFullYear()}${p(d.getUTCMonth() + 1)}${p(d.getUTCDate())}-${p(d.getUTCHours())}${p(d.getUTCMinutes())}${p(d.getUTCSeconds())}`;",
          "fieldType": "string"
        }
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "setupInstructions",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Setup instructions",
        "subLabel": "",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "expression": "if ($vars.start.output.smokeOnly) { return `Write-Output '[setup] smoke: skipped clone/install'\n`; }\nreturn `$ErrorActionPreference = 'Stop'\n  $repo = 'C:\\\\vm-agent\\\\repo'\n  $bin  = 'C:\\\\vm-agent\\\\bin'\n  $branch = '${$vars.start.output.branch}'\n  $url = '${$vars.start.output.repoUrl}'\n  if ($env:GIT_TOKEN) { $url = $url -replace '^https://', \"https://x-access-token:$($env:GIT_TOKEN)@\" }\n  New-Item -ItemType Directory -Force -Path 'C:\\\\vm-agent' | Out-Null\n  New-Item -ItemType Directory -Force -Path $bin | Out-Null\n  $env:PATH = \"$bin;$env:PATH\"\n  if (-not (Test-Path \"$bin\\\\rg.exe\")) {\n    Write-Output '[setup] installing ripgrep into bin'\n    $rel = Invoke-RestMethod https://api.github.com/repos/BurntSushi/ripgrep/releases/latest -Headers @{ 'User-Agent' = 'vm-agent' }\n    $asset = ($rel.assets | Where-Object name -like '*-x86_64-pc-windows-msvc.zip').browser_download_url\n    Invoke-WebRequest $asset -OutFile \"$env:TEMP\\\\rg.zip\" -UseBasicParsing\n    Expand-Archive \"$env:TEMP\\\\rg.zip\" -DestinationPath \"$env:TEMP\\\\rg\" -Force\n    Copy-Item (Get-ChildItem \"$env:TEMP\\\\rg\" -Recurse -Filter rg.exe | Select-Object -First 1).FullName $bin\n  }\n  $rgLines = @(rg --version)\n  if ($LASTEXITCODE -ne 0) { throw '[setup] rg not available' }\n  Write-Output \"[setup] rg $($rgLines[0])\"\n  if (Test-Path \"$repo\\\\.git\") {\n    Write-Output \"[setup] reusing clone at $repo\"\n    git -C $repo fetch --depth 50 origin $branch\n    if ($LASTEXITCODE -ne 0) { throw \"[setup] git fetch failed with $LASTEXITCODE\" }\n    git -C $repo reset --hard FETCH_HEAD\n    if ($LASTEXITCODE -ne 0) { throw \"[setup] git reset failed with $LASTEXITCODE\" }\n  } else {\n    Write-Output \"[setup] cloning $branch\"\n    git clone --depth 50 --branch $branch $url $repo\n    if ($LASTEXITCODE -ne 0) { throw \"[setup] git clone failed with $LASTEXITCODE\" }\n  }\n  Set-Location $repo\n  corepack enable --install-directory $bin pnpm\n  if (Test-Path \"$bin\\\\pnpm.cmd\") { Write-Output \"[setup] pnpm shim at $bin\\\\pnpm.cmd\" } else { Write-Output \"[setup] WARNING: no pnpm shim in $bin\" }\n  cmd.exe /c \"set PATH=$bin;%PATH% && corepack pnpm install --frozen-lockfile\"\n  if ($LASTEXITCODE -ne 0) { throw \"[setup] pnpm install failed with $LASTEXITCODE\" }\n  cmd.exe /c \"set PATH=$bin;%PATH% && corepack pnpm exec playwright install chromium\"\n  if ($LASTEXITCODE -ne 0) { throw \"[setup] playwright install failed with $LASTEXITCODE\" }\n  Write-Output \"[setup] head: $(git -C $repo rev-parse --short HEAD)\"\n  $pnpmVer = cmd.exe /c \"set PATH=$bin;%PATH% && pnpm --version\"\n  Write-Output \"[setup] pnpm: $pnpmVer\"\n  Write-Output \"[setup] done\"\n`",
          "fieldType": "string"
        }
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "testRunInstructions",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Test run instructions",
        "subLabel": "",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "expression": "return `$ErrorActionPreference = 'Continue'\n  $repo = 'C:\\\\vm-agent\\\\repo'\n  $bin  = 'C:\\\\vm-agent\\\\bin'\n  Set-Location $repo\n  $cmd = '${$vars.start.output.testCommand}'\n  Write-Output \"[test] $cmd\"\n  cmd.exe /c \"set PATH=$bin;%PATH% && set CI=true && $cmd\"\n  $exit = $LASTEXITCODE\n\n  $stamp = Get-Date -UFormat \"%Y%m%d-%H%M%S\"\n  $art = \"C:\\\\vm-agent\\\\artifacts\\\\$stamp\"\n  New-Item -ItemType Directory -Force -Path $art | Out-Null\n  if (Test-Path \"$repo\\\\e2e\\\\test-results\") {\n    Compress-Archive -Path \"$repo\\\\e2e\\\\test-results\\\\*\" -DestinationPath \"$art\\\\test-results.zip\" -Force\n  }\n  if (Test-Path \"$repo\\\\e2e\\\\playwright-report\") {\n    Compress-Archive -Path \"$repo\\\\e2e\\\\playwright-report\\\\*\" -DestinationPath \"$art\\\\playwright-report.zip\" -Force\n  }\n  Write-Output \"[artifacts] $art\"\n  Get-ChildItem -Path \"$repo\\\\e2e\\\\test-results\" -Recurse -File -ErrorAction SilentlyContinue |\n    Where-Object { $_.Name -eq 'error-context.md' -or $_.Name -eq 'trace.zip' } |\n    ForEach-Object { Write-Output \"[artifact] $($_.FullName)\" }\n\n  exit $exit\n  `",
          "fieldType": "string"
        }
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "decision1",
      "type": "core.logic.decision",
      "typeVersion": "1.3",
      "display": {
        "label": "Investigation Complete?",
        "subLabel": "",
        "icon": "trending-up-down"
      },
      "inputs": {
        "trueLabel": "True",
        "falseLabel": "False",
        "expression": {
          "type": "jsExpression",
          "expression": "$vars.iteration > $vars.start.output.maxIterations || $vars.investigator.output.investigationComplete",
          "fieldType": "boolean"
        }
      }
    },
    {
      "id": "investigationSummarizer",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.4",
      "display": {
        "label": "Investigation Summarizer",
        "subLabel": "",
        "shape": "rectangle",
        "icon": "autonomous-agent"
      },
      "inputs": {
        "systemPrompt": "You write the final report for an automated e2e test investigation. You have no tools.\nYou are given: the failing test command, the test run's exit code and output tail, the bucket path of the full log, and the investigator's notebook (its own record across passes).\n\nBase every claim on the notebook and the test output. Never invent a cause that the notebook does not support.\n\nSet classification to:\n  - regression: the notebook identifies a code change that breaks the test\n  - flake: timing/ordering dependent, passes on retry, no code cause\n  - infrastructure: the VM, licensing, environment or tooling caused it, not the product\n  - known-platform-issue: a known Studio Web / Orchestrator / solution failure\n  - inconclusive: the notebook does not establish a cause\n\nIf the notebook is missing or empty, set classification to inconclusive, explain that inunverified, and report what the raw test output alone shows.\n\nQuote decisive error lines in evidence, with file:line where the notebook has them, and list the bucket log paths. State plainly in unverified what remains unchecked. An honest gap is more useful than a confident guess.",
        "userPrompt": "Test command: {{ $vars.start.output.testCommand }}\nRepository: {{ $vars.start.output.repoUrl }} @ {{ $vars.start.output.branch }}\nTest exit code: {{ $vars.testEvidence.output.exitCode }}\nFull test log in bucket: {{ $vars.testEvidence.output.blobPath }}\nInvestigation passes used: {{ $vars.iteration }} of {{ $vars.start.output.maxIterations }}\n\nTest run output tail: {{ $vars.testEvidence.output.stdout }}\n\nInvestigator notebook: {{ $vars.readNotes.output.Stdout }}\n\nFix attempt (may be empty if no fix was attempted): {{ $vars.fixer.output.fixSummary }} (confidence {{ $vars.fixer.output.confidence }})\nVerification output (may be empty if no patch was verified): {{ $vars.verifyFix.output.Stdout }}\nPR step output (may be empty if no PR was opened): {{ $vars.openPr.output.Stdout }}\n\nWrite the final report. Base every claim on the notebook and the test output above, and fill every field of the output schema.\n\nSet patch to the diff verbatim from the `### patch` section of the verification output, or empty if there is none. Set fixVerified to true only if the verification output contains `FIX_VERIFIED=true`; otherwise false. Set prUrl to the value after `PR_URL=` in the PR step output if present, else the empty string.",
        "model": "anthropic.claude-opus-4-8",
        "mode": "standard",
        "agentInputVariables": [],
        "agentOutputVariables": [
          {
            "id": "reproduced",
            "type": "boolean",
            "required": true
          },
          {
            "id": "hypothesis",
            "type": "string",
            "required": true
          },
          {
            "id": "evidence",
            "type": "string",
            "required": true
          },
          {
            "id": "patch",
            "type": "string",
            "required": true,
            "description": "The diff verbatim from the ### patch section of the verification output, or empty"
          },
          {
            "id": "fixVerified",
            "type": "boolean",
            "required": true,
            "description": "true only if the verification output contains FIX_VERIFIED=true"
          },
          {
            "id": "prUrl",
            "type": "string",
            "required": true,
            "description": "The value after PR_URL= in the PR step output, or empty"
          }
        ],
        "source": "ee9f4167-4fc2-4b1b-a1a7-dfb48a9bfff4",
        "temperature": 0,
        "maxTokenPerResponse": 16384,
        "maxIterations": 25,
        "modelMaxTokens": 128000
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "readNotes",
      "type": "uipath.core.rpa-workflow.209d4dde-a982-4fc5-a498-4f818f667453",
