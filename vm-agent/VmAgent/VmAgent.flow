{
  "id": "31b0a5d8-7787-4c4d-84ca-a78490eb8e70",
  "version": "1.9",
  "name": "VmAgent",
  "runtime": "maestro",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger",
        "icon": "play"
      },
      "inputs": {
        "entryPointId": "9169d066-e626-4372-b2f6-fb1c45863eb4",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the process.",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "id": "setupVm",
      "type": "uipath.core.rpa-workflow.ca36341d-ecec-4ba6-aa76-134d0afe4ba7",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Set up VM (clone + install)",
        "subLabel": "",
        "icon": "rpa"
      },
      "inputs": {
        "Script": {
          "type": "jsExpression",
          "expression": "$vars.setupInstructions.output",
          "fieldType": "string"
        },
        "WorkDir": "C:\\vm-agent",
        "RunId": "=js:$vars.start.output.runId + '/setup'",
        "TimeoutMinutes": 30
      },
      "outputs": {
        "output": {
          "type": "object",
          "source": "=this",
          "var": "output",
          "description": "Process output arguments (ExitCode, Stdout, OutputBlobPath)",
          "schema": {
            "type": "object",
            "properties": {
              "ExitCode": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              "Stdout": {
                "type": "string"
              },
              "OutputBlobPath": {
                "type": "string"
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "runTest",
      "type": "uipath.core.rpa-workflow.ca36341d-ecec-4ba6-aa76-134d0afe4ba7",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Run failing test",
        "subLabel": "",
        "icon": "rpa"
      },
      "inputs": {
        "Script": {
          "type": "jsExpression",
          "expression": "$vars.testRunInstructions.output",
          "fieldType": "string"
        },
        "WorkDir": "C:\\vm-agent",
        "RunId": "=js:$vars.start.output.runId + '/test'",
        "TimeoutMinutes": 45
      },
      "outputs": {
        "output": {
          "type": "object",
          "source": "=this",
          "var": "output",
          "description": "Process output arguments (ExitCode, Stdout, OutputBlobPath)",
          "schema": {
            "type": "object",
            "properties": {
              "ExitCode": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              "Stdout": {
                "type": "string"
              },
              "OutputBlobPath": {
                "type": "string"
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
