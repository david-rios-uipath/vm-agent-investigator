    {
      "id": "decisionPr",
      "type": "core.logic.decision",
      "typeVersion": "1.3",
      "display": {
        "label": "Fix verified?",
        "subLabel": "",
        "icon": "trending-up-down"
      },
      "inputs": {
        "trueLabel": "True",
        "falseLabel": "False",
        "expression": {
