    {
      "id": "parseStatusRepro",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Parse repro status",
        "subLabel": "",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "expression": "// The runner prints exactly one STATUS_JSON= line, last. Parse that line and nothing else;\n// its absence means the runner itself broke.\nconst out = $vars.repro.output || {};\nconst lines = String(out.Stdout || '').split('\\n');\nfor (let i = lines.length - 1; i >= 0; i--) {\n  const l = lines[i].trim();\n  if (l.startsWith('STATUS_JSON=')) {\n    try { return JSON.parse(l.slice('STATUS_JSON='.length)); } catch (e) { break; }\n  }\n}\nreturn { runnerFailed: true, exitCode: out.ExitCode, blobPath: out.OutputBlobPath || '' };",
          "fieldType": "string"
        }
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "id": "bootstrapInvestigate",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Bootstrap investigate",
        "subLabel": "",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "expression": "// The VM gets the phase logic from this repo, not from the flow: a runner change is a git\n// push, not a solution release. `runnerRef` selects the ref to run.\nconst s = (v) => String(v ?? '').replace(/'/g, \"''\");\nconst runId = s($vars.deriveRunId.output);\nconst ref = s($vars.start.output.runnerRef || 'master');\nconst args = [\n  \"-Phase investigate\",\n  `-RunId '${runId}'`,\n  `-RepoUrl '${s($vars.start.output.repoUrl)}'`,\n  `-Branch '${s($vars.start.output.branch)}'`,\n  `-TestCommand '${s($vars.start.output.testCommand)}'`,\n  $vars.start.output.claudeModel ? `-Model '${s($vars.start.output.claudeModel)}'` : \"\",\n\n].join(' ');\nreturn `$ErrorActionPreference = 'Continue'\n$runner = 'C:\\\\vm-agent\\\\runner'\n$url = '${s($vars.start.output.runnerRepoUrl)}'\nif (-not $url) { Write-Output '[bootstrap] runnerRepoUrl is empty; nothing to clone'; exit 1 }\nif ($env:GIT_TOKEN) { $url = $url -replace '^https://', \"https://x-access-token:$($env:GIT_TOKEN)@\" }\nif (-not (Test-Path \"$runner\\\\.git\")) {\n  git clone --depth 1 $url $runner\n  if ($LASTEXITCODE -ne 0) { Write-Output '[bootstrap] clone of the runner repo failed'; exit 1 }\n}\ngit -C $runner remote set-url origin $url\ngit -C $runner fetch --depth 1 origin ${ref}\nif ($LASTEXITCODE -ne 0) { Write-Output '[bootstrap] fetch of the runner repo failed'; exit 1 }\ngit -C $runner checkout -q FETCH_HEAD\ngit -C $runner remote set-url origin '${s($vars.start.output.runnerRepoUrl)}'\nWrite-Output \"[bootstrap] runner at $(git -C $runner rev-parse --short HEAD)\"\n& \"$runner\\\\vm\\\\run-phase.ps1\" ${args}\nexit $LASTEXITCODE\n`",
          "fieldType": "string"
        }
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
