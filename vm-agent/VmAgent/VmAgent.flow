            "value": ""
          },
          {
            "name": "name",
            "type": "string",
            "value": ""
          },
          {
            "name": "entryPoint",
            "type": "string",
            "value": ""
          }
        ]
      },
      "debug": {
        "runtime": "bpmnEngine"
      }
    },
