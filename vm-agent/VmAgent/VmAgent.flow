    {
      "id": "vmExecToolFixer",
      "type": "uipath.agent.resource.tool.process.209d4dde-a982-4fc5-a498-4f818f667453",
      "typeVersion": "1.0.0",
      "display": {
        "label": "vm-exec",
        "subLabel": "",
        "icon": "rpa"
      },
      "inputs": {
        "source": "6adb473b-ece0-4b66-b468-fda51bbc7df1",
        "id": "vmExecToolFixer",
        "name": "vm_exec",
        "description": "Run a PowerShell script on the Windows robot VM and get its output. The VM is a persistent Windows Server with git, node, corepack/pnpm and rg (ripgrep) on PATH; the repo is at C:\\vm-agent\\repo. Returns the exit code, the last 8000 chars of merged stdout+stderr, and the bucket path of the complete log. WorkDir, RunId and a 3-minute timeout are fixed by the flow. Each call costs 45-75 seconds of fixed overhead regardless of script length, so batch: one call should run every command a step needs, with Write-Output '### <label>' separators. Output is capped at 8000 chars, so filter (rg -n, Select-String, Select-Object -First N, Get-Content -TotalCount N) instead of dumping whole files.",
        "guardrails": [],
        "isEnabled": true,
        "referenceKey": "209d4dde-a982-4fc5-a498-4f818f667453",
        "inputSchema": {
          "type": "object",
          "properties": {
            "Script": {
              "type": "string",
              "description": "PowerShell script to run on the VM (powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass). Multiple lines allowed. Batch several probes per script with Write-Output '### <label>' separators and $ErrorActionPreference = 'Continue'. Hard 3-minute timeout (exit code 124); output tail capped at 8000 chars. Search with rg, never Get-ChildItem -Recurse over packages/ or node_modules."
            },
            "WorkDir": {
              "type": "string",
              "description": "Working directory on the VM. Fixed by the flow (C:\\vm-agent); do not set."
            },
            "RunId": {
              "type": "string",
              "description": "Log grouping prefix in the storage bucket. Fixed by the flow; do not set."
            },
            "TimeoutMinutes": {
              "type": "number",
              "description": "Fixed by the flow at 3 minutes; do not set. Exit code 124 means it timed out."
            },
            "guardrails": {
              "type": "array"
            }
          },
          "required": [
            "Script"
          ]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "ExitCode": {
              "type": "integer",
              "description": "0 = success, 124 = timeout, -1 = runner exception"
            },
            "Stdout": {
              "type": "string",
              "description": "Merged stdout+stderr, tail-truncated to 8000 chars; full log in the bucket at OutputBlobPath"
            },
            "OutputBlobPath": {
              "type": "string",
              "description": "Path of the complete log inside the e2e-investigations bucket"
            }
          }
        },
        "properties": {
          "folderPath": "e2e-investigator",
          "processName": "vm-exec-vm",
          "exampleCalls": []
        },
        "argumentProperties": {},
        "settings": {},
        "folderPath": "e2e-investigator",
        "Script": {
          "mode": "prompt",
          "textValue": "",
          "promptValue": "PowerShell script to run on the VM. Multiple lines allowed. Runs with powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass. Batch several commands per script (with Write-Output '### <label>' separators and $ErrorActionPreference = 'Continue'); one command per call wastes the ~40 s fixed cost of each call.",
          "argumentPath": ""
        },
        "WorkDir": {
          "mode": "text-builder",
          "textValue": "C:\\vm-agent",
          "promptValue": "",
          "argumentPath": ""
        },
        "RunId": {
          "mode": "variable",
          "textValue": "",
          "promptValue": "",
          "argumentPath": "start__output__runId"
        },
        "TimeoutMinutes": {
          "mode": "text-builder",
          "textValue": "3",
          "promptValue": "",
          "argumentPath": ""
        }
      }
    },
    {
      "id": "decisionFix",
      "type": "core.logic.decision",
      "typeVersion": "1.3",
      "display": {
        "label": "Patch written?",
        "subLabel": "",
        "icon": "trending-up-down"
      },
      "inputs": {
        "trueLabel": "True",
        "falseLabel": "False",
        "expression": {
          "type": "jsExpression",
          "expression": "$vars.fixer.output.patchWritten !== true",
          "fieldType": "boolean"
        }
      }
    },
    {
      "id": "verifyFixInstructions",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Verify fix instructions",
        "subLabel": "",
        "icon": "code"
      },
      "inputs": {
        "script": {
          "type": "literal",
          "expression": "return `$ErrorActionPreference = 'Continue'\n  $repo = 'C:\\\\vm-agent\\\\repo'\n  $bin  = 'C:\\\\vm-agent\\\\bin'\n  $patch = \"C:\\\\vm-agent\\\\notes\\\\${$vars.deriveRunId.output}\\\\fix.patch\"\n  Set-Location $repo\n  if (-not (Test-Path $patch)) {\n    Write-Output 'FIX_VERIFIED=false'\n    Write-Output '[verify] no fix.patch'\n    exit 0\n  }\n  Write-Output '### patch'\n  Get-Content $patch\n  Write-Output '### git apply --check'\n  git apply --check $patch 2>&1 | ForEach-Object { Write-Output \"$_\" }\n  if ($LASTEXITCODE -ne 0) {\n    Write-Output 'FIX_VERIFIED=false'\n    Write-Output '[verify] git apply --check failed'\n    exit 0\n  }\n  git apply $patch 2>&1 | ForEach-Object { Write-Output \"$_\" }\n  $cmd = '${$vars.start.output.testCommand} --retries=0 --reporter=line'\n  Write-Output \"### test $cmd\"\n  cmd.exe /c \"set PATH=$bin;%PATH% && set CI=true && $cmd\"\n  $exit = $LASTEXITCODE\n  Write-Output \"### test exit $exit\"\n  git checkout -- . 2>&1 | Out-Null\n  git clean -fd -- e2e 2>&1 | Out-Null\n  Write-Output \"FIX_VERIFIED=$(if ($exit -eq 0) {'true'} else {'false'})\"\n  `",
          "fieldType": "string"
        }
      },
      "outputs": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
