    <bpmn:scriptTask id="setupInstructions" name="Setup instructions" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:context>
            <uipath:inputSchema type="jsonSchema"><![CDATA[{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"vars":{"type":"object"},"metadata":{"type":"object"}},"required":[]}]]></uipath:inputSchema>
          </uipath:context>
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"vars":"=vars","metadata":"=metadata"}]]></uipath:input>
          <uipath:output name="setupInstructions.output" type="object" source="=result.response" var="setupInstructions.output" />
          <uipath:output name="setupInstructions.error" type="object" source="=Error" var="setupInstructions.error" />
        </uipath:mapping>
        <uipath:scriptVersion value="v3" />
      </bpmn:extensionElements>
      <bpmn:incoming>edge_start-output-core.action.script-1788369234104-input</bpmn:incoming>
      <bpmn:outgoing>edge_core.action.script-1788369234104-success-setupVm-input</bpmn:outgoing>
      <bpmn:script><![CDATA[return `$ErrorActionPreference = 'Stop'
  $repo = 'C:\\vm-agent\\repo'
  $bin  = 'C:\\vm-agent\\bin'
  $branch = '${vars.start.output.branch}'
  $url = '${vars.start.output.repoUrl}'
  if ($env:GIT_TOKEN) { $url = $url -replace '^https://', "https://x-access-token:$($env:GIT_TOKEN)@" }
  New-Item -ItemType Directory -Force -Path 'C:\\vm-agent' | Out-Null
  New-Item -ItemType Directory -Force -Path $bin | Out-Null
  $env:PATH = "$bin;$env:PATH"
  if (Test-Path "$repo\\.git") {
    Write-Output "[setup] reusing clone at $repo"
    git -C $repo fetch --depth 50 origin $branch
    if ($LASTEXITCODE -ne 0) { throw "[setup] git fetch failed with $LASTEXITCODE" }
    git -C $repo reset --hard FETCH_HEAD
    if ($LASTEXITCODE -ne 0) { throw "[setup] git reset failed with $LASTEXITCODE" }
  } else {
    Write-Output "[setup] cloning $branch"
    git clone --depth 50 --branch $branch $url $repo
    if ($LASTEXITCODE -ne 0) { throw "[setup] git clone failed with $LASTEXITCODE" }
  }
  Set-Location $repo
  corepack enable --install-directory $bin pnpm
  if (Test-Path "$bin\\pnpm.cmd") { Write-Output "[setup] pnpm shim at $bin\\pnpm.cmd" } else { Write-Output "[setup] WARNING: no pnpm shim in $bin" }
  cmd.exe /c "set PATH=$bin;%PATH% && corepack pnpm install --frozen-lockfile"
  if ($LASTEXITCODE -ne 0) { throw "[setup] pnpm install failed with $LASTEXITCODE" }
  cmd.exe /c "set PATH=$bin;%PATH% && corepack pnpm exec playwright install chromium"
  if ($LASTEXITCODE -ne 0) { throw "[setup] playwright install failed with $LASTEXITCODE" }
  Write-Output "[setup] head: $(git -C $repo rev-parse --short HEAD)"
  $pnpmVer = cmd.exe /c "set PATH=$bin;%PATH% && pnpm --version"
  Write-Output "[setup] pnpm: $pnpmVer"
  Write-Output "[setup] done"
`]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="testRunInstructions" name="Test run instructions" scriptFormat="JavaScript">
      <bpmn:extensionElements>
        <uipath:mapping version="v1">
          <uipath:type value="BPMN.Variables" version="v1" />
          <uipath:context>
            <uipath:inputSchema type="jsonSchema"><![CDATA[{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"vars":{"type":"object"},"metadata":{"type":"object"}},"required":[]}]]></uipath:inputSchema>
          </uipath:context>
          <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"vars":"=vars","metadata":"=metadata"}]]></uipath:input>
          <uipath:output name="testRunInstructions.output" type="object" source="=result.response" var="testRunInstructions.output" />
          <uipath:output name="testRunInstructions.error" type="object" source="=Error" var="testRunInstructions.error" />
        </uipath:mapping>
        <uipath:scriptVersion value="v3" />
      </bpmn:extensionElements>
      <bpmn:incoming>edge_setupVm-output-core.action.script-1788369273375-input</bpmn:incoming>
      <bpmn:outgoing>edge_core.action.script-1788369273375-success-runTest-input</bpmn:outgoing>
      <bpmn:script><![CDATA[return `$ErrorActionPreference = 'Continue'
  $repo = 'C:\\vm-agent\\repo'
  $bin  = 'C:\\vm-agent\\bin'
  Set-Location $repo
  $cmd = '${vars.start.output.testCommand}'
  Write-Output "[test] $cmd"
  cmd.exe /c "set PATH=$bin;%PATH% && set CI=true && $cmd"
  $exit = $LASTEXITCODE

  $stamp = Get-Date -UFormat "%Y%m%d-%H%M%S"
  $art = "C:\\vm-agent\\artifacts\\$stamp"
  New-Item -ItemType Directory -Force -Path $art | Out-Null
  if (Test-Path "$repo\\e2e\\test-results") {
    Compress-Archive -Path "$repo\\e2e\\test-results\\*" -DestinationPath "$art\\test-results.zip" -Force
  }
  if (Test-Path "$repo\\e2e\\playwright-report") {
    Compress-Archive -Path "$repo\\e2e\\playwright-report\\*" -DestinationPath "$art\\playwright-report.zip" -Force
  }
  Write-Output "[artifacts] $art"
  Get-ChildItem -Path "$repo\\e2e\\test-results" -Recurse -File -ErrorAction SilentlyContinue |
    Where-Object { $_.Name -eq 'error-context.md' -or $_.Name -eq 'trace.zip' } |
    ForEach-Object { Write-Output "[artifact] $($_.FullName)" }

  exit $exit
  `]]></bpmn:script>
    </bpmn:scriptTask>
