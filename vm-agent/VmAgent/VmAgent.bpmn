        <uipath:scriptVersion value="v3" />
      </bpmn:extensionElements>
      <bpmn:incoming>edge_decision1-true-core.action.script-1788377935950-input</bpmn:incoming>
      <bpmn:outgoing>edge_core.action.script-1788377935950-success-vmExecVm1-input</bpmn:outgoing>
      <bpmn:script><![CDATA[return `$notes = "C:\\vm-agent\\notes\\${vars.start.output.runId}\\NOTES.md"
  if (Test-Path $notes) { Get-Content $notes } else { Write-Output "[notes] MISSING - no notebook was written" }
`]]></bpmn:script>
