  <Sequence DisplayName="Run script on VM" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="logPath" />
      <Variable x:TypeArguments="x:String" Name="blobName" />
    </Sequence.Variables>
    <ui:InvokeCode DisplayName="Run script" sap2010:WorkflowViewState.IdRef="InvokeCode_1" Language="CSharp"
      sap2010:Annotation.AnnotationText="Writes Script to a temp file and runs it (powershell.exe -File on Windows, /bin/sh elsewhere). Environment variables are inherited from the robot process; GIT_TOKEN, GH_NPM_REGISTRY_TOKEN and PLAYWRIGHT_PASSWORD values are redacted from the returned output. ExitCode 124 = timeout, -1 = runner exception. Stdout is the last 32000 chars; the full log goes to the bucket."
      Code="var sw = System.Diagnostics.Stopwatch.StartNew();&#xA;string root = string.IsNullOrWhiteSpace(WorkDir)&#xA;    ? System.IO.Path.Combine(System.IO.Path.GetTempPath(), &quot;vm-agent&quot;)&#xA;    : WorkDir;&#xA;System.IO.Directory.CreateDirectory(root);&#xA;bool win = System.OperatingSystem.IsWindows();&#xA;string scriptPath = System.IO.Path.Combine(root, &quot;vm-exec-&quot; + System.Guid.NewGuid().ToString(&quot;N&quot;) + (win ? &quot;.ps1&quot; : &quot;.sh&quot;));&#xA;string logPath = scriptPath + &quot;.log&quot;;&#xA;var sb = new System.Text.StringBuilder();&#xA;int exitCode = -1;&#xA;&#xA;try&#xA;{&#xA;    System.IO.File.WriteAllText(scriptPath, Script);&#xA;    System.Diagnostics.ProcessStartInfo psi;&#xA;    if (win)&#xA;    {&#xA;        psi = new System.Diagnostics.ProcessStartInfo(&quot;powershell.exe&quot;);&#xA;        foreach (var a in new[] { &quot;-NoProfile&quot;, &quot;-NonInteractive&quot;, &quot;-ExecutionPolicy&quot;, &quot;Bypass&quot;, &quot;-File&quot;, scriptPath })&#xA;            psi.ArgumentList.Add(a);&#xA;    }&#xA;    else&#xA;    {&#xA;        psi = new System.Diagnostics.ProcessStartInfo(&quot;/bin/sh&quot;);&#xA;        psi.ArgumentList.Add(scriptPath);&#xA;    }&#xA;    psi.WorkingDirectory = root;&#xA;    psi.UseShellExecute = false; psi.CreateNoWindow = true;&#xA;    psi.RedirectStandardOutput = true; psi.RedirectStandardError = true;&#xA;    using (var p = new System.Diagnostics.Process { StartInfo = psi })&#xA;    {&#xA;        p.OutputDataReceived += (s, e) =&gt; { if (e.Data != null) lock (sb) sb.AppendLine(e.Data); };&#xA;        p.ErrorDataReceived += (s, e) =&gt; { if (e.Data != null) lock (sb) sb.AppendLine(e.Data); };&#xA;        p.Start(); p.BeginOutputReadLine(); p.BeginErrorReadLine();&#xA;        int limitMin = TimeoutMinutes &gt; 0 ? TimeoutMinutes : 30;&#xA;        if (!p.WaitForExit(limitMin * 60 * 1000))&#xA;        {&#xA;            try { p.Kill(true); } catch { }&#xA;            p.WaitForExit();&#xA;            lock (sb) sb.AppendLine(&quot;[runner] TIMEOUT after &quot; + limitMin + &quot; minutes - process tree killed&quot;);&#xA;            exitCode = 124;&#xA;        }&#xA;        else&#xA;        {&#xA;            p.WaitForExit();&#xA;            exitCode = p.ExitCode;&#xA;        }&#xA;    }&#xA;}&#xA;catch (System.Exception ex)&#xA;{&#xA;    sb.AppendLine(&quot;[runner] exception: &quot; + ex);&#xA;    exitCode = -1;&#xA;}&#xA;sw.Stop();&#xA;&#xA;string body = sb.ToString();&#xA;// Redact any secret the robot carries in its environment.&#xA;foreach (var name in new[] { &quot;GIT_TOKEN&quot;, &quot;GH_NPM_REGISTRY_TOKEN&quot;, &quot;PLAYWRIGHT_PASSWORD&quot; })&#xA;{&#xA;    string v = System.Environment.GetEnvironmentVariable(name);&#xA;    if (!string.IsNullOrEmpty(v) &amp;&amp; v.Length &gt; 6) body = body.Replace(v, &quot;***&quot; + name + &quot;***&quot;);&#xA;}&#xA;string header = &quot;work dir: &quot; + root + &quot;\nscript:\n&quot; + Script&#xA;    + &quot;\n\nexit code: &quot; + exitCode + &quot;\nduration seconds: &quot; + (int)sw.Elapsed.TotalSeconds + &quot;\n\n&quot;;&#xA;string full = header + body;&#xA;System.IO.File.WriteAllText(logPath, full);&#xA;&#xA;// Agent tool arguments have a size limit; return the tail and keep the whole log in the bucket.&#xA;const int cap = 32000;&#xA;string tail = full.Length &lt;= cap&#xA;    ? full&#xA;    : &quot;[runner] output truncated to last &quot; + cap + &quot; chars; full log in bucket\n&quot; + full.Substring(full.Length - cap);&#xA;&#xA;try { System.IO.File.Delete(scriptPath); } catch { }&#xA;&#xA;ExitCode = exitCode;&#xA;Stdout = tail;&#xA;LogPath = logPath;&#xA;BlobName = RunId + &quot;/&quot; + System.DateTime.UtcNow.ToString(&quot;yyyyMMdd-HHmmss&quot;) + &quot;-&quot; + System.Guid.NewGuid().ToString(&quot;N&quot;).Substring(0, 6) + &quot;-exec.log&quot;;&#xA;">
      <ui:InvokeCode.Arguments>
        <scg:Dictionary x:TypeArguments="x:String, Argument">
          <InArgument x:TypeArguments="x:String" x:Key="Script">[Script]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="WorkDir">[WorkDir]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="RunId">[RunId]</InArgument>
          <InArgument x:TypeArguments="x:Int32" x:Key="TimeoutMinutes">[TimeoutMinutes]</InArgument>
          <OutArgument x:TypeArguments="x:Int32" x:Key="ExitCode">[ExitCode]</OutArgument>
          <OutArgument x:TypeArguments="x:String" x:Key="Stdout">[Stdout]</OutArgument>
          <OutArgument x:TypeArguments="x:String" x:Key="LogPath">[logPath]</OutArgument>
          <OutArgument x:TypeArguments="x:String" x:Key="BlobName">[blobName]</OutArgument>
        </scg:Dictionary>
      </ui:InvokeCode.Arguments>
    </ui:InvokeCode>
    <ui:LogMessage DisplayName="Log result" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info"
      Message="[&quot;Script finished with exit code &quot; &amp; ExitCode.ToString() &amp; &quot;; uploading &quot; &amp; blobName &amp; &quot; to bucket e2e-investigations&quot;]" />
    <ucas:UploadStorageFile DisplayName="Upload log to e2e-investigations" sap2010:WorkflowViewState.IdRef="UploadStorageFile_1"
      FileResource="{x:Null}" TimeoutMS="{x:Null}" ContinueOnError="True"
      StorageBucketName="[&quot;e2e-investigations&quot;]" Path="[logPath]" Destination="[blobName]" />
    <Assign DisplayName="OutputBlobPath" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[OutputBlobPath]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[blobName]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:Delete DisplayName="Delete local log (best effort)" sap2010:WorkflowViewState.IdRef="Delete_1" ContinueOnError="True" Path="[logPath]" ResourceFile="{x:Null}" />
  </Sequence>
